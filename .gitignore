# Hoot 0.8 live-hacking dev bundles (see docs/dev/LIVE_HACKING.md)
browser/.dev/
playnet.code-workspace

# Rust build artifacts
# rns-wasm/ and server/rns-bridge/ are satellites (deploy/satellites.scm),
# placed by `make satellites` locally and by the CI hook on the box — never
# tracked here. Their build products stay ignored under them too.
/rns-wasm
/server/rns-bridge
# build-rns-wasm.sh's tool cache (wasm-bindgen-cli + cargo home), kept across deploys
/.rns-wasm-tools/

# rns-wasm built artifacts copied for serving (rebuild with wasm-pack).
# The crate itself lives at the repo root, OUTSIDE the served browser/
# tree; only these two products land in the document root.
browser/rns_wasm.js
browser/rns_wasm_bg.wasm
# build-rns-wasm.sh's content stamp: the hash of the crate sources those two were built from
browser/.rns-wasm-stamp

# repl.wasm is a 10.5 MB BUILD PRODUCT of hoot/repl.scm and the modules it
# imports. It was tracked, so every rebuild wrote ten megabytes of churn into
# the history of a repo that has twice been rewritten to stay small. The box
# builds its own copy — radicle-ci-hook.sh runs `make browser/repl.wasm` on
# each push — so the committed bytes were never the ones being served.
# Build locally with: make browser/repl.wasm
browser/repl.wasm

# Vendored transformers.js + ONNX runtime for the local Whisper worker.
# Committed to the repo so prod's rad-CI rsync ships them — gitignoring
# them broke the prod path because the radicle-ci-hook can't re-fetch
# 22 MB from a CDN over Tor on every deploy. fetch.sh updates them.

# Corpus texts, derived indexes and embedding-model weights.
# manifest.scm + profile.scm ARE committed — they carry the provenance and the
# fetch recipe, so `corpus fetch && corpus build` reconstructs everything here.
# The bytes themselves stay local: .git is already large, every Radicle clone
# and CI rsync pays for what lands in it, and third-party book text has no
# business on a public remote. See docs/corpus/README.md.
docs/corpus/**/texts/
docs/corpus/**/.index/
docs/corpus/.models/
tools/corpus/node_modules/

# Provider configs contain server IPs — NEVER commit
deploy/providers/*.scm
!deploy/providers/example.scm

# Fleet reconciler — materialized host state (contains IPs)
deploy/hosts.scm
deploy/desired-fleet.scm
deploy/fleet-network.scm

# age encryption key — NEVER commit (back up alongside Monero seed)
deploy/.age-key.txt

# A real household's own family-budget numbers (ui/app/tabs/family.ts,
# ?familydata=local) — NEVER commit. This repo is public and anonymously
# cloneable; real names/vendors/amounts stay on the machine that typed them.
browser/app/family-data*.local.json
# YubiKey identity is SAFE to commit (it's a public reference to the
# hardware key slot, not a secret — decryption requires physical touch)
!deploy/.age-yubikey-identity.txt

# Dev notes
docs/dev/build-notes.md
docs/dev/opsec-roadmap.md
docs/dev/sms-wall.md

# Third-party source PDFs (copyrighted; kept local, not seeded on the channel)
docs/SecondOrder_Leuven22_references/

# Build scripts with embedded credentials — NEVER commit
build-iso.sh

# Guix system image symlinks + GC roots from `make iso` / `make iso-raw`.
# Local pointers at /gnu/store paths; rebuild instead of committing.
result-iso
result-iso-raw

# Claude Code / opencode: local settings ignored via line 8 above.
# agents/commands/skills/plans are versioned; .opencode/.gitignore excludes its own
# node_modules/package*.json.

# Deploy snapshot of the booted ISO — contains the live host IP, never commit
deploy/iso-cid.txt

# gateway runtime state (designator/vapid keys, syrup stores, srefs) — never commit
/data/

# local Valhalla build + tiles (not vendored)
.valhalla/

# Capacitor shell (app/): deps + generated artifacts — cap sync recreates
app/node_modules/
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
app/android/app/src/main/assets/capacitor.plugins.json
app/android/.gradle/
app/android/app/build/
app/android/build/
app/android/local.properties
app/www/
app/android/capacitor-cordova-android-plugins/
.dev-data/

# opsec audit report — never commit (contains the leak inventory)
OPSEC-LEAKS.local.md

# docs/planning/*.local.md — any planning note meant to stay off canonical,
# by convention
docs/planning/*.local.md

# docs/legal/agreements/ — the member-body agreement template and every filled copy.
# A filled agreement names real organisations, addresses and signatories; this
# repo is public and pseudonymous. Nothing under it is ever committed.
/docs/legal/agreements/

# Real Radicle seed list (production onion) — delivered out-of-band, never committed
deploy/radicle-seeds.local.txt

# Python bytecode cache (build artifact)
**/__pycache__/

# Reference scans — kept local, out of the Tor-seeded repo. A 12 MB book is a
# permanent 12 MB in every clone, and a filename carrying its download site
# advertises that site to everyone who fetches the project.
docs/*essays in optimal planning*.pdf

# Large antifragile reference binaries — kept local, out of the Tor-seeded repo
docs/antifragile/**/*.pdf
docs/antifragile/**/*.png
docs/antifragile/**/*.jpeg
docs/antifragile/**/*.jpg

# dev live-reload token (tools/livereload-watch.py)
browser/reload-token.txt

# dev onion data dir (tools/onion.sh) — contains the hidden-service key, never commit
.onion-data/

# basemap tile proxy cache (server/serve-static.scm /tiles)
# the basemap's glyph ranges (10 MB of Noto Sans): tools/map-tiles.sh fetches
# them beside the archives; the deploy rsync ships them with browser/
browser/assets/map/fonts/

# Safety net: headless-browser dev screenshots go to ~/playnet-dev-shots (OUTSIDE
# this repo). But if a stray headless Firefox/Chromium run ever writes a profile
# into the tree again, never let its scratch files become committable. Anchored
# to the repo root (leading /) — a browser profile only ever lands at top level,
# so this can't shadow a legit *.sqlite fixture nested elsewhere.
/cache2/
/startupCache/
/extension-store/
/extensions/
/*.sqlite
/*.sqlite-wal
/*.sqlite-shm
/prefs.js
/.parentlock
/sessionCheckpoints.json
/SiteSecurityServiceState.bin
/bounce-tracking-protection.sqlite

# browser e2e scratch (tests/ux/ux-full.sh keeps it on failure for diagnosis)
/.ux-e2e-data/
.test-failures/

# solver-certificate Lean project (docs/formal/): not part of playnet's
# build (see its own README). `lake update`/`lake build` fetch mathlib and
# its ~7 dependencies plus their prebuilt .olean cache into .lake/ — a
# multi-GB build artifact, not source. lake-manifest.json (the dependency
# lockfile, pinning exact revs) IS committed, same as Cargo.lock.
docs/formal/solver-certificate/.lake/

# --- Slim-repo policy (2026-08-27): a public Tor-seeded clone pays forever
# for every committed byte, and heartwood's 2-minute fetch window caps how
# much a contributor can pull. The pack budget is ~50 MiB. ---

# Hoot wasm build products — the box builds its own on each deploy
# (radicle-ci-hook.sh build_browser_wasm, P-filtered in the rsync); the
# repl.wasm note above carries the full story.
browser/day-boot.wasm
browser/family.wasm
browser/scope.wasm
weave/weave.wasm

