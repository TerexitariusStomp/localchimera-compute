;;; test-count-anchor.scm — the ledger follows the latest count, whatever order
;;; the counts and the flows arrive in.
(define %project-root (string-append (dirname (current-filename)) "/../.."))
(chdir %project-root)
(add-to-load-path "module")
(use-modules (playnet test harness)
             (goblins) (goblins persistence-store memory) (goblins utils hashmap)
             (playnet scope root) (playnet vf schemas) (srfi srfi-1) (playnet doors service)
             ((playnet observation observer) #:select (void-event))
             (srfi srfi-1))
(use-modules ((playnet wire rows) #:select (plain-reply)))   ; a door's rows, read back as alists

(define store (make-memory-store))
(define-values (vat scope)
  (spawn-persistent-vat scope-root-env (lambda () (spawn-scope-root "Commune")) store))
(define svc (with-vat vat (spawn ^planner-service (hashmap-set (hashmap) "org:commune" scope))))
(define (call m . a) (plain-reply (with-vat vat (apply $ svc m a))))
(define (obs m . a) (with-vat vat (apply $ ($ scope 'observer) m a)))
(define (onhand rid) (measure-qty (economic-resource-onhand-quantity (obs 'get-resource rid))))
(define (near? a b) (< (abs (- a b)) 1e-6))
(define %n 0)
(define (uid p) (set! %n (+ 1 %n)) (string-append p (number->string %n)))
(define (seed! rid spec qty)
  (obs 'seed-resource
       (make-economic-resource #:id rid #:name spec #:conforms-to spec #:classified-as '()
                               #:accounting-quantity (make-measure qty "kg") #:onhand-quantity (make-measure qty "kg")
                               #:current-location "place:pantry" #:primary-accountable "ada")))
(define (seed-in! rid spec qty in)
  (obs 'seed-resource
       (make-economic-resource #:id rid #:name spec #:conforms-to spec #:classified-as '()
                               #:accounting-quantity (make-measure qty "kg") #:onhand-quantity (make-measure qty "kg")
                               #:current-location "place:pantry" #:primary-accountable "ada" #:contained-in in)))
(define (iso hh mm) (format #f "2026-09-28T~2,'0d:~2,'0d:00Z" hh mm))
;; a flow: a consume (d < 0) or a raise-less produce stand-in via 'raise (d > 0)
(define (flow! rid d at)
  (obs 'record-event
       (make-economic-event
        #:id (uid "flow-") #:action (if (< d 0) 'consume 'raise)
        #:resource-inventoried-as rid #:resource-conforms-to "spec" #:provider "ada" #:receiver "ada" #:resource-quantity (make-measure (abs d) "kg") #:has-point-in-time at #:created at #:note "flow" #:in-scope-of '("org:commune"))))
(define (count! rid n at)
  (call 'count-stock "org:commune" "ada" rid (exact->inexact n) "kg" "stated" "" at "" "" ""))
(define (ok? r) (and (pair? r) (eq? (car r) 'ok)))
(define (sighting r) (and (ok? r) (assq-ref (cdr r) 'sighting)))

(display "\n── 1. a flow logged late, before the count, moves nothing ──\n")
(seed! "flour" "flour" 10.0)
(count! "flour" 7 (iso 10 0))
(check "the count sets the ledger" (onhand "flour") 7.0)
(flow! "flour" -3 (iso 8 0))       ; the bake, logged after the count that saw its result
(check "the late bake is already in the count" (onhand "flour") 7.0)
(flow! "flour" -1 (iso 11 0))      ; a use after the count
(check "a flow after the count moves the stock" (onhand "flour") 6.0)

(display "\n── 2. an earlier count is a sighting ──\n")
(seed! "rice" "rice" 10.0)
(count! "rice" 10 (iso 10 0))
(define r2 (count! "rice" 8 (iso 9 0)))
(check "the earlier count lands" (ok? r2) #t)
(check "as an earlier sighting" (sighting r2) "earlier")
(check "the ledger stays at the later count" (onhand "rice") 10.0)

(display "\n── 3. same instant: the later landing stands ──\n")
(seed! "oats" "oats" 10.0)
(count! "oats" 8 (iso 9 0))
(count! "oats" 9 (iso 9 0))
(check "tied counts: the later landing" (onhand "oats") 9.0)

(display "\n── 4. a bin and its jar ──\n")
(seed! "bin" "bin" 10.0)
(seed-in! "bin/jar" "jar" 4.0 "bin")
(count! "bin" 5 (iso 10 0))
(check "the jar scaled" (onhand "bin/jar") 2.0)
(define r4 (count! "bin/jar" 3 (iso 9 0)))
(check "an older jar photo is an earlier sighting" (sighting r4) "earlier")
(check "jar unchanged" (onhand "bin/jar") 2.0)
(define r4b (count! "bin/jar" 3 (iso 11 0)))
(check "a later jar count anchors" (onhand "bin/jar") 3.0)

(display "\n── 5. voiding the latest count ──\n")
(seed! "tea" "tea" 10.0)
(count! "tea" 9 (iso 8 0))
(define r5 (count! "tea" 6 (iso 10 0)))
(check "tea at 6" (onhand "tea") 6.0)
(flow! "tea" -1 (iso 9 0))   ; between the counts, logged after: already in the 10:00 count
(check "still 6" (onhand "tea") 6.0)
(define adj (assq-ref (cdr r5) 'event))
(obs 'record-event (void-event (obs 'get-event adj) (uid "void-") "wrong" "org:commune" (iso 12 0)))
(obs 'record-event (void-event (obs 'get-event (assq-ref (cdr r5) 'record)) (uid "void-") "wrong" "org:commune" (iso 12 0)))
(check "the 08:00 count anchors again; the 09:00 flow follows it" (onhand "tea") 8.0)


;;; ── 6. confluence: any order of arrival, one ledger ─────────────────────
(display "\n── 6. the same counts and flows in any order give one ledger ──\n")
(use-modules (srfi srfi-1))
(define rs (seed->random-state 20260928))
(define (shuffle l)
  (map cdr (sort (map (lambda (x) (cons (random 1.0 rs) x)) l)
                 (lambda (a b) (< (car a) (car b))))))
(define (rand-between lo hi) (+ lo (random (+ 1 (- hi lo)) rs)))
(define (minute->iso m) (iso (+ 8 (quotient m 60)) (remainder m 60)))
;; an item: (flow at d) | (count at fig void?)
(define (oracle items)
  (let* ((cs (filter (lambda (i) (and (eq? 'count (car i)) (not (cadddr i)))) items))
         (fl (filter (lambda (i) (eq? 'flow (car i))) items))
         (a  (and (pair? cs) (fold (lambda (c b) (if (> (cadr c) (cadr b)) c b)) (car cs) (cdr cs)))))
    (if a
        (+ (caddr a) (apply + (map (lambda (f) (if (> (cadr f) (cadr a)) (caddr f) 0)) fl)))
        (+ 100 (apply + (map caddr fl))))))
(define (play! rid items void-order)
  (for-each
   (lambda (i)
     (case (car i)
       ((flow) (flow! rid (caddr i) (minute->iso (cadr i))))
       ((count)
        (let ((r (count! rid (caddr i) (minute->iso (cadr i)))))
          (when (cadddr i)
            (let ((evs (filter (lambda (x) (and x (not (equal? x ""))))
                               (list (assq-ref (cdr r) 'event) (assq-ref (cdr r) 'record)))))
              (for-each (lambda (id)
                          (obs 'record-event (void-event (obs 'get-event id) (uid "void-") "x" "org:commune" (iso 13 0))))
                        (if (eq? void-order 'rec-first) (reverse evs) evs))))))))
   items))
(define fails 0)
(define (trial! n voids?)
  (let* ((rid (string-append "t" (number->string n)))
         (k (rand-between 2 5)) (m (rand-between 1 4))
         (mins (shuffle (iota 120)))
         (flows (map (lambda (j) (list 'flow (list-ref mins j) (- (rand-between 1 5)))) (iota k)))
         (counts (map (lambda (j) (list 'count (list-ref mins (+ k j)) (rand-between 20 90)
                                        (and voids? (< (random 1.0 rs) 0.35))))
                      (iota m)))
         (items (shuffle (append flows counts))))
    (seed! rid rid 100.0)
    (play! rid items (if (even? n) 'adj-first 'rec-first))
    (let ((want (oracle (append flows counts))) (got (onhand rid)))
      (unless (near? want got)
        (set! fails (+ fails 1))
        (format #t "  MISMATCH ~a: want ~a got ~a items ~s\n" rid want got items)))))
(for-each (lambda (n) (trial! n #f)) (iota 10 1))
(check "10 shuffled trials: ledger = latest count + flows after it" fails 0)
(for-each (lambda (n) (trial! n #t)) (iota 20 101))
(check "20 more with voided counts" fails 0)

(test-summary!)
