;;; test-audit.scm — the audit arithmetic (planner/facts/audit.scm), pure.
(use-modules ((localchimera utils units) #:select (%count-unit)))
(use-modules (localchimera test harness) (localchimera vf schemas) (localchimera vf facts audit))
(define (ev id act spec who q at)
  (make-economic-event #:id id #:action act #:resource-conforms-to spec #:provider (if (eq? act 'consume) who "commune") #:receiver (if (eq? act 'consume) #f who)
                       #:resource-quantity (make-measure q %count-unit) #:has-point-in-time at))
(display "\n── Becker's rate ──\n")
(check "gain = consequence ⇒ audit always" (audit-rate 5.0 5.0) 1.0)
(check "consequence k× the gain ⇒ π = 1/k" (audit-rate 5.0 20.0) 0.25)
(check "an unmeasured gain audits always" (audit-rate #f 20.0) 1.0)
(check "no consequence audits always" (audit-rate 5.0 0.0) 1.0)
(check "nothing to gain, nothing to audit" (audit-rate 0.0 20.0) 0.0)
(display "\n── what the observer saw ──\n")
(define evs (list (ev "e1" 'consume "bread" "ada" 2.0 "2026-09-01T10:00:00Z")
                  (ev "e2" 'transfer "bread" "ada" 1.0 "2026-09-02T10:00:00Z")
                  (ev "e3" 'consume "bread" "ben" 5.0 "2026-09-02T10:00:00Z")
                  (ev "e4" 'consume "milk" "ada" 9.0 "2026-09-02T10:00:00Z")
                  (ev "e5" 'consume "bread" "ada" 4.0 "2026-08-01T10:00:00Z")))
(check "ada's bread: her consumes and what was transferred to her, since the grant"
       (observed-of evs "bread" "ada" #:since "2026-09-01T00:00:00Z") 3.0)
(check "…all time counts the older one too" (observed-of evs "bread" "ada") 7.0)
(check "ben's is ben's" (observed-of evs "bread" "ben") 5.0)
(display "\n── the verdict ──\n")
(check "taken within a quarter of declared: confirmed" (audit-verdict 4.0 3.0) 'confirmed)
(check "well short: padded" (audit-verdict 10.0 3.0) 'padded)
(check "declared nothing: confirmed" (audit-verdict 0.0 0.0) 'confirmed)
(display "\n── the draw ──\n")
(check "reproducible" (audit-draw "bread" "ada" "2026-09-02") (audit-draw "bread" "ada" "2026-09-02"))
(check "in [0,1)" (let ((d (audit-draw "x" "y"))) (and (>= d 0.0) (< d 1.0))) #t)
(test-summary!)
