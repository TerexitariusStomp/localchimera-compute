;;; test-count-expected.scm — what the plan expects of a stock when it is counted.
;;;
;;; The plan's last solve holds its produce, consume and move rows; a row bears on
;;; a stock when it is the stock's good at the stock's place, begins by the count's
;;; instant and has not been met. The count door answers the range those rows leave
;;; the stock in, and the record states it.
;;;
;;; Run from project root:
;;;   tools/test/own-ccache.sh guile --no-auto-compile -q -L module tests/doors/test-count-expected.scm

(define %project-root (string-append (dirname (current-filename)) "/../.."))
(chdir %project-root)
(add-to-load-path "module")
(use-modules (playnet test harness)
             (goblins) (goblins persistence-store memory) (goblins utils hashmap)
             (playnet scope root) (playnet vf schemas) (srfi srfi-1) (playnet doors service)
             ((playnet vf formulas counting) #:select (count-expected count-figure))
             ((playnet utils keyed-id) #:select (keyed-id))
             (srfi srfi-1))
(use-modules ((playnet wire rows) #:select (plain-reply)))   ; a door's rows, read back as alists

(define %standing (@@ (playnet doors service) %standing))   ; the live service's reads
(define (cache-solve! sid demand alist)   ; a plan landed for the live service's SID
  ((@ (playnet doors planner solve-cache) cache-solve!) (%standing 'cache) sid demand alist))

(define store (make-memory-store))
(define-values (vat scope)
  (spawn-persistent-vat scope-root-env (lambda () (spawn-scope-root "Commune")) store))
(define svc (with-vat vat (spawn ^planner-service (hashmap-set (hashmap) "org:commune" scope))))
(define (call m . a) (plain-reply (with-vat vat (apply $ svc m a))))
(define (obs m . a) (with-vat vat (apply $ ($ scope 'observer) m a)))
(define (onhand rid) (measure-qty (economic-resource-onhand-quantity (obs 'get-resource rid))))
(define (near? a b) (< (abs (- a b)) 1e-6))
(define (ok? r) (and (pair? r) (eq? (car r) 'ok)))
(define (field r k) (and (ok? r) (assq-ref (cdr r) k)))
(define (seed! rid spec qty owner place)
  (obs 'seed-resource
       (make-economic-resource #:id rid #:name spec #:conforms-to spec #:classified-as '()
                               #:accounting-quantity (make-measure qty "kg") #:onhand-quantity (make-measure qty "kg")
                               #:current-location place #:primary-accountable owner)))
(define (row id action good q place when proc . note)
  `((id . ,id) (action . ,action) (conforms-to . ,good) (quantity . ,q)
    (output-of . ,(and (memq action '(produce dropoff)) proc)) (input-of . ,(and (not (memq action '(produce dropoff))) proc))
    (at-location . ,place) (when . ,when) (note . ,(if (pair? note) (car note) #f))
    (classified-as . ())))
(define (plan! rows)
  (with-vat vat (cache-solve! "org:commune" '() `((material . ,rows)))))
(define (count! rid n at)
  (call 'count-stock "org:commune" "ada" rid (exact->inexact n) "kg" "stated" "" at "" "" ""))
(define (low r) (assq-ref (field r 'expected) 'low))
(define (high r) (assq-ref (field r 'expected) 'high))
(define (flows r) (assq-ref (field r 'expected) 'flows))
(define (tags-of r) (economic-event-resource-classified-as (obs 'get-event (field r 'record))))

(display "\n── 1. no plan: the range is the ledger ──\n")
(seed! "pantry/rice" "rice" 10.0 "org:commune" "place:pantry")
(define r1 (count! "pantry/rice" 10 "2026-09-28T10:00:00Z"))
(check-pred "a range of one point" (and (near? (low r1) 10.0) (near? (high r1) 10.0)))
(check "no flows behind it" (flows r1) '())
(check "and the record states none" (count-expected (tags-of r1)) #f)

(display "\n── 2. the plan's flows that began by then ──\n")
(seed! "pantry/flour" "flour" 10.0 "org:commune" "place:pantry")
(plan! (list (row "bake" 'consume "flour" 3.0 "place:pantry" "2026-09-28T08:00:00Z" "bake")
             (row "delivery" 'produce "flour" 5.0 "place:pantry" "2026-09-28T09:00:00Z" "mill")
             (row "next-week" 'produce "flour" 4.0 "place:pantry" "2026-09-29T09:00:00Z" "mill")
             (row "elsewhere" 'consume "flour" 9.0 "place:shed" "2026-09-28T08:00:00Z" "bake")
             (row "other-good" 'consume "oats" 9.0 "place:pantry" "2026-09-28T08:00:00Z" "bake")
             (let ((m (row "wind" 'produce "flour" 9.0 "place:pantry" "2026-09-28T08:00:00Z" "sky")))
               (cons '(classified-as . ("ambient")) (alist-delete 'classified-as m)))))
(define r2 (count! "pantry/flour" 7 "2026-09-28T10:00:00Z"))
(check "the bake and the delivery bear on the flour"
       (sort (map (lambda (f) (assq-ref f 'id)) (flows r2)) string<?) '("bake" "delivery"))
(check-pred "signed by what each does" (equal? '(-3.0 5.0)
                                               (map (lambda (f) (assq-ref f 'quantity))
                                                    (sort (flows r2) (lambda (a b) (string<? (assq-ref a 'id) (assq-ref b 'id)))))))
(check-pred "low takes every draw, high every addition" (and (near? (low r2) 7.0) (near? (high r2) 15.0)))
(check-pred "the record states the range beside the figure"
            (let ((e (count-expected (tags-of r2))))
              (and e (near? (car e) 7.0) (near? (cadr e) 15.0) (equal? "kg" (cddr e)))))
(check-pred "and the figure" (equal? '(7.0 . "kg") (count-figure (tags-of r2))))
(check-pred "the ledger took the count as ever" (near? (onhand "pantry/flour") 7.0))

(display "\n── 3. a count of an earlier instant sees fewer flows ──\n")
(seed! "pantry/flour2" "flour" 10.0 "org:commune" "place:pantry")
(define r3 (count! "pantry/flour2" 10 "2026-09-28T08:30:00Z"))
(check "at 08:30 only the bake had begun" (map (lambda (f) (assq-ref f 'id)) (flows r3)) '("bake"))

(display "\n── 4. a carry takes at its origin and adds at its destination ──\n")
(seed! "shed/rice" "rice" 2.0 "org:commune" "place:shed")
(plan! (list (row "carry.pu" 'pickup "rice" 4.0 "place:pantry" "2026-09-28T08:00:00Z" "carry")
             (row "carry.do" 'dropoff "rice" 4.0 "place:shed" "2026-09-28T08:00:00Z" "carry")))
(define r4a (count! "pantry/rice" 10 "2026-09-28T10:00:00Z"))
(define r4b (count! "shed/rice" 2 "2026-09-28T10:00:00Z"))
(check-pred "the origin may hold four fewer" (and (near? (low r4a) 6.0) (near? (high r4a) 10.0)))
(check-pred "the destination may hold four more" (and (near? (low r4b) 2.0) (near? (high r4b) 6.0)))

(display "\n── 5. what the events have met is no longer expected ──\n")
(define (flow-row stock proc)
  (let ((cid (keyed-id "mc" "consume" stock proc "place:pantry" "place:pantry" "2026-09-28T08:00:00Z")))
    (row cid 'consume stock 5.0 "place:pantry" "2026-09-28T08:00:00Z" proc)))
(define (record! stock proc q)
  (call 'record-flow "org:commune" "consume" stock q 5.0 "place:pantry" "2026-09-28T08:00:00Z" proc #f))
(seed! "pantry/salt" "salt" 10.0 "org:commune" "place:pantry")
(seed! "pantry/pepper" "pepper" 10.0 "org:commune" "place:pantry")
(plan! (list (flow-row "salt" "salting") (flow-row "pepper" "peppering")))
(check-pred "five of the salt are expected gone" (near? (low (count! "pantry/salt" 10 "2026-09-27T07:00:00Z")) 10.0))
(check "…once the row has begun" (map (lambda (f) (assq-ref f 'quantity)) (flows (count! "pantry/pepper" 10 "2026-09-28T07:59:00Z"))) '())
(seed! "pantry/mace" "mace" 10.0 "org:commune" "place:pantry")
(plan! (list (flow-row "mace" "macing")))
(define r5a (count! "pantry/mace" 10 "2026-09-28T09:00:00Z"))
(check-pred "five of the mace are expected gone" (near? (low r5a) 5.0))
(seed! "pantry/clove" "clove" 10.0 "org:commune" "place:pantry")
(plan! (list (flow-row "clove" "cloving")))
(check-pred "two of five recorded: the ledger moved" (ok? (record! "clove" "cloving" 2.0)))
(check-pred "…to eight" (near? (onhand "pantry/clove") 8.0))
(define r5b (count! "pantry/clove" 8 "2026-09-28T09:00:00Z"))
(check-pred "three still expected" (near? (low r5b) 5.0))
(check-pred "…of the ledger as it stands" (near? (high r5b) 8.0))
(seed! "pantry/sage" "sage" 10.0 "org:commune" "place:pantry")
(plan! (list (flow-row "sage" "saging")))
(record! "sage" "saging" 5.0)
(check "met in full, nothing is expected" (flows (count! "pantry/sage" 5 "2026-09-28T09:00:00Z")) '())

(with-vat vat ($ ($ scope 'agent-store) 'add-agent (make-agent #:id "ada" #:type 'person
                                                               #:name "ada" #:classified-as '())))
;; the plan's vocabulary: a recipe makes jam and none uses it, so a kept jar is its keeper's own.
;; The world is the vat's (one whole value, templates included), so it is declared there.
(with-vat vat
  ((@ (playnet solve engine) declare-world!)
   #:spans '((0 "2026-09-28" "2026-09-28"))
   #:templates (list (list "preserve" '(("jam" . 1.0)) '() 0.0 '() '() '() '() '()))))
(display "\n── 6. a person's stock is a lot of the good they own ──\n")
(seed! "ada/jam" "jam" 6.0 "ada" "place:pantry")
(plan! (list (row "eat-jam" 'consume "jam~ada" 2.0 "place:pantry" "2026-09-28T08:00:00Z" "supper")
             (row "eat-any-jam" 'consume "jam" 3.0 "place:pantry" "2026-09-28T08:00:00Z" "supper")))
(define r6 (count! "ada/jam" 6 "2026-09-28T10:00:00Z"))
(check "only the row for her jam" (map (lambda (f) (assq-ref f 'id)) (flows r6)) '("eat-jam"))
(display "\n── 7. the inventory carries the range on a stock the plan bears on ──\n")
;; the inventory shows what conforms to a spec the recipes know
(for-each (lambda (spec)
            (with-vat vat ($ ($ scope 'recipe-store) 'add-resource-spec
                             (make-resource-specification #:id spec #:name spec
                                                          #:resource-classified-as '()
                                                          #:default-unit-of-resource "kg"))))
          '("lentil" "millet"))
(seed! "pantry/lentil" "lentil" 10.0 "org:commune" "place:pantry")
(seed! "pantry/millet" "millet" 10.0 "org:commune" "place:pantry")
(plan! (list (row "lentils" 'consume "lentil" 4.0 "place:pantry" "2026-09-28T08:00:00Z" "soup")))
(define snap #f)
(define (read-snap!) (set! snap (call 'inventory-snapshot "org:commune" #f)))
(read-snap!)
(define (res-of id) (find (lambda (r) (equal? id (assq-ref r 'id))) (assq-ref (cdr snap) 'resources)))
(check-pred "the stock the plan bears on carries its range"
            (let ((e (assq-ref (res-of "pantry/lentil") 'expected)))
              (and e (near? (assq-ref e 'low) 6.0) (near? (assq-ref e 'high) 10.0)
                   (equal? "soup" (assq-ref (car (assq-ref e 'flows)) 'proc)))))
(check "a stock no row bears on carries none" (assq-ref (res-of "pantry/millet") 'expected) #f)
(plan! '())
(read-snap!)
(check "with no plan, the listing is the books' own"
       (assq-ref (res-of "pantry/lentil") 'expected) #f)
(display "\n── 8. the drift reads the part the plan does not account for ──\n")
(define (drift-of spec) (assq-ref (cdr (call 'scope-readings "org:commune" spec)) 'drift))
(define (mean-abs spec) (assq-ref (drift-of spec) 'mean-abs))
(seed! "pantry/oil" "oil" 10.0 "org:commune" "place:pantry")
(seed! "pantry/vinegar" "vinegar" 10.0 "org:commune" "place:pantry")
(plan! (list (row "oiling" 'consume "oil" 3.0 "place:pantry" "2026-09-28T08:00:00Z" "frying")))
(count! "pantry/oil" 7 "2026-09-28T10:00:00Z")       ; the plan's three, unlogged: nothing is off
(count! "pantry/vinegar" 7 "2026-09-28T10:00:00Z")    ; no plan for it: three is a ledger off by three
(sleep 1)
(check-pred "a count inside the plan's range found nothing off" (near? (mean-abs "oil") 0.0))
(check "…yet it is a count" (assq-ref (drift-of "oil") 'n) 1)
(check-pred "a count the plan does not explain is the difference it found" (near? (mean-abs "vinegar") 3.0))
(seed! "pantry/cumin" "cumin" 10.0 "org:commune" "place:pantry")
(plan! (list (row "cumin-use" 'consume "cumin" 3.0 "place:pantry" "2026-09-28T08:00:00Z" "frying")))
(count! "pantry/cumin" 4 "2026-09-28T10:00:00Z")
(sleep 1)
(check-pred "past the range, the excess is what the ledger was off by" (near? (mean-abs "cumin") 3.0))
;;; ── 9. a count that moves a stock marks the plan stale ───────────────────
(display "\n── 9. a count that moves the stock marks the plan stale ──\n")
(define (stale?) ((@ (playnet doors planner solve-cache) solve-stale?) (%standing 'cache) "org:commune"))
(seed! "pantry/thyme" "thyme" 10.0 "org:commune" "place:pantry")
(plan! '())                                   ; a solve lands: the plan is fresh
(check "a fresh plan is not stale" (stale?) #f)
(count! "pantry/thyme" 10 "2026-09-28T10:00:00Z")
(check "a count that agrees leaves it fresh" (stale?) #f)
(count! "pantry/thyme" 6 "2026-09-28T11:00:00Z")
(check "a count that moves the stock marks it stale" (stale?) #t)
(plan! '())
(check "the next solve clears the mark" (stale?) #f)
(test-summary!)
