;;; test-inspection-in-plan.scm — inspection as first-class labour IN the plan.
;;;
;;; Not the isolated economics (that is test-inspection-cadence.scm) but the SOLVER
;;; itself: a multi-period `solve-native` program where a conformance edge's
;;; verification FRESHNESS decays over time (drift δ), a fragility barrier feels any
;;; RELIANCE beyond what has been verified (−w·log(V−Q)), and INSPECTION — priced as
;;; labour, competing for the same budget as production — regenerates the freshness.
;;; The inspection intensity is a decision variable; its cadence EMERGES, and the
;;; reliance that drives it (D = the plan's own throughput on the edge) is endogenous.
;;;
;;; This is the twin of the Cond|durable / skill-refresher recurrence (planner.scm
;;; 922, 1044): a stock that decays and is regenerated by dedicated labour, carried
;;; across periods — here the stock is "how recently verified", the labour a recert.
;;; Design: docs/legal/inspection-in-plan.md.
;;;
;;; Per period t: Q_t production through the edge, V_t freshness, a_t inspection
;;; intensity ∈ [0,1], S_t a SAFE substitute (extra labour c_s, no freshness need).
;;;   • freshness   (bar):  (1−δ)·V_{t−1} + ρ·a_t − V_t ≥ 0     (regen − decay)
;;;   • confidence (frag):  −w·log(V_t − Q_t)                    (reliance ≤ verified)
;;;   • demand      (des):  Q_t + S_t → D  (weight W)            (D = reliance)
;;;   • inspection (labform): a_t priced at ℓ; substitute S_t at c_s
;;;
;;; Run:  guile -L module/localchimera/planner tests/solve/test-inspection-in-plan.scm

(use-modules (srfi srfi-1) (ice-9 format))
(use-modules (localchimera solve solver))
(use-modules (localchimera knowledge catalogues conformance))  ; governed barrier steepness

(set! *kappa* 1.0)   ; price labour at 1/hour so inspection cost reads directly as ℓ

;; solve one T-period plan; return (values mean-a a-list V-list Q-list). The confidence
;; barrier weight w defaults to the GOVERNED conformance-confidence steepness.
(define* (plan T #:key (delta 0.3) (D 0.6) (ell 1.0) (w (conformance-frag-weight)) (rho 1.0)
                       (W 10.0) (Vinit 1.0) (c-s 100.0))
  (define n (* 4 T))
  (define (Q t) (* 4 t)) (define (V t) (+ (* 4 t) 1))
  (define (A t) (+ (* 4 t) 2)) (define (S t) (+ (* 4 t) 3))
  (define forms '()) (define lab '())
  (define (add! f) (set! forms (cons f forms)))
  (do ((t 0 (+ t 1))) ((= t T))
    (add! (mk-bar (if (= t 0) (* (- 1.0 delta) Vinit) 0.0)          ; freshness recurrence
                  (append (if (= t 0) '() (list (cons (V (- t 1)) (- 1.0 delta))))
                          (list (cons (A t) rho) (cons (V t) -1.0)))))
    (add! (mk-frag 0.0 (list (cons (V t) 1.0) (cons (Q t) -1.0)) w)) ; confidence: reliance ≤ verified
    (add! (mk-des (mk-bar 0.0 (list (cons (Q t) 1.0) (cons (S t) 1.0))) D W))  ; demand via edge OR substitute
    (add! (mk-bar 0.0 (list (cons (A t) 1.0))))                     ; a ≥ 0
    (add! (mk-bar 1.0 (list (cons (A t) -1.0))))                    ; a ≤ 1
    (add! (mk-bar 0.0 (list (cons (Q t) 1.0))))                     ; Q ≥ 0
    (add! (mk-bar 0.0 (list (cons (S t) 1.0))))                     ; S ≥ 0
    (set! lab (cons (cons (A t) ell) (cons (cons (S t) c-s) lab))))
  (define x0 (make-vector n 0.05))
  (do ((t 0 (+ t 1))) ((= t T)) (vector-set! x0 (V t) Vinit))
  (call-with-values (lambda () (solve-native forms lab x0))
    (lambda (x . _)
      (let ((as (map (lambda (t) (vector-ref x (A t))) (iota T)))
            (vs (map (lambda (t) (vector-ref x (V t))) (iota T)))
            (qs (map (lambda (t) (vector-ref x (Q t))) (iota T))))
        (values (/ (fold + 0.0 as) T) as vs qs)))))

(define (mean-a . kw) (call-with-values (lambda () (apply plan 8 kw)) (lambda (m . _) m)))
(define (rising? xs) (equal? xs (sort xs <)))
(define (falling? xs) (equal? xs (sort xs >)))

(format #t "~%── inspection cadence emerges from the plan; reliance (the dual) drives it ──~%")

;; P1 — reliance drives inspection: raise demand D (the plan's own throughput) ⇒ a rises.
(define p1 (map (lambda (D) (mean-a #:D D)) '(0.3 0.6 0.9)))
(format #t "  P1 reliance   D = 0.3 0.6 0.9  →  ā = ~a~%" (map (lambda (a)(format #f "~,3f" a)) p1))

;; P2 — cheaper checks, more inspection: raise ℓ ⇒ a falls.
(define p2 (map (lambda (l) (mean-a #:ell l)) '(0.5 1.0 2.0)))
(format #t "  P2 check cost ℓ = 0.5 1.0 2.0  →  ā = ~a~%" (map (lambda (a)(format #f "~,3f" a)) p2))

;; P3 — faster drift, more inspection: raise δ ⇒ a rises.
(define p3 (map (lambda (d) (mean-a #:delta d)) '(0.15 0.30 0.50)))
(format #t "  P3 drift      δ = .15 .30 .50  →  ā = ~a~%" (map (lambda (a)(format #f "~,3f" a)) p3))

;; P4 — substitution relaxes inspection: as a safe substitute cheapens, the plan
;; routes around the fragile edge, its reliance falls, and inspection recedes. Shown
;; on a costlier edge (faster drift, dearer check) so the co-determination is visible.
(define p4 (map (lambda (cs) (mean-a #:ell 1.5 #:delta 0.45 #:c-s cs)) '(100.0 1.0 0.5)))
(format #t "  P4 substitute c_s = ∞  1.0  0.5  →  ā = ~a~%" (map (lambda (a)(format #f "~,3f" a)) p4))

;; P5 — the plan never relies on more conformance than it has verified: V_t ≥ Q_t.
(define slack-ok
  (call-with-values (lambda () (plan 8))
    (lambda (m as vs qs) (every (lambda (v q) (>= (- v q) -1e-6)) vs qs))))
(format #t "  P5 freshness ahead of reliance (V_t ≥ Q_t every period): ~a~%" (if slack-ok "yes" "NO"))

(define c1 (rising? p1))
(define c2 (falling? p2))
(define c3 (rising? p3))
(define c4 (and (falling? p4) (< (last p4) (* 0.8 (car p4)))))   ; recedes, and materially (≥20%)
(define c5 slack-ok)
(for-each (lambda (tag ok) (format #t "  [~a] ~a~%" (if ok "✓" "✗") tag))
          '("P1 reliance (the endogenous dual) drives inspection up"
            "P2 a cheaper check is done more often"
            "P3 faster conformance drift ⇒ more inspection"
            "P4 a well-substituted conformance is inspected less — co-determined in ONE solve"
            "P5 the plan never leans on unverified conformance (V ≥ Q)")
          (list c1 c2 c3 c4 c5))

(define ok (and c1 c2 c3 c4 c5))
(format #t "~%  ~a inspection is first-class: a scheduled, labour-priced activity whose cadence emerges~%" (if ok "✓" "✗"))
(format #t "    from the plan's own reliance — no formula imposed, the fragility barrier + freshness stock compose it~%~%")
(exit (if ok 0 1))
