{
  "$id": "EK5a3X3Eo5tLmlq9RJwwKSvmTiHso3VX_yoUX_bOatJh",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalChimera Skill Credential",
  "description": "Membership token: the holder holds a skill, minted once per (person, skill) on first performance, edged to its founding work event. Carries no hours; competence is summed from the work log.",
  "type": "object",
  "credentialType": "LocalChimeraSkillCredential",
  "version": "1.0.0",
  "properties": {
    "v": {
      "type": "string",
      "description": "ACDC version string"
    },
    "d": {
      "type": "string",
      "description": "Credential SAID"
    },
    "u": {
      "type": "string",
      "description": "Optional salt"
    },
    "i": {
      "type": "string",
      "description": "Issuer AID prefix (scope or training authority)"
    },
    "ri": {
      "type": "string",
      "description": "Registry identifier (TEL)"
    },
    "s": {
      "type": "string",
      "description": "Schema SAID"
    },
    "a": {
      "oneOf": [
        {
          "type": "string",
          "description": "Attributes-block SAID (compact form)"
        },
        {
          "type": "object",
          "properties": {
            "d": {
              "type": "string",
              "description": "Attributes-block SAID"
            },
            "i": {
              "type": "string",
              "description": "Holder AID prefix (the worker)"
            },
            "dt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 issuance timestamp"
            },
            "skill": {
              "type": "string",
              "description": "The skill ResourceSpecification id"
            },
            "founding-event-id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Founding work-event SAID"
            },
            "valid-from": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "valid-until": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "Recertification expiry; past ⇒ lapsed"
            },
            "issued-by": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "d",
            "i",
            "dt",
            "skill"
          ],
          "additionalProperties": false
        }
      ]
    },
    "e": {
      "oneOf": [
        {
          "type": "string",
          "description": "Edge-block SAID (compact form)"
        },
        {
          "type": "object",
          "description": "ACDC edge block: named edges to other credentials",
          "properties": {
            "d": {
              "type": "string",
              "description": "Edge-block SAID"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "v",
    "d",
    "i",
    "ri",
    "s",
    "a"
  ],
  "additionalProperties": false
}
