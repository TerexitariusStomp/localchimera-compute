{
  "$id": "EFa-iyAUs7q2syZQxIJyBT8eamn2bHv2FdxvKKN5_2tO",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalChimera Intent Credential",
  "description": "Attests a planning intent (a unilateral provider-XOR-receiver signal) with its desired quantities and plan membership.",
  "type": "object",
  "credentialType": "LocalChimeraIntentCredential",
  "version": "1.0.0",
  "properties": {
    "v": {
      "type": "string",
      "description": "ACDC version string"
    },
    "d": {
      "type": "string",
      "description": "Credential SAID"
    },
    "u": {
      "type": "string",
      "description": "Optional salt"
    },
    "i": {
      "type": "string",
      "description": "Issuer AID prefix (the declaring agent)"
    },
    "ri": {
      "type": "string",
      "description": "Registry identifier (TEL)"
    },
    "s": {
      "type": "string",
      "description": "Schema SAID"
    },
    "a": {
      "oneOf": [
        {
          "type": "string",
          "description": "Attributes-block SAID (compact form)"
        },
        {
          "type": "object",
          "properties": {
            "d": {
              "type": "string",
              "description": "Attributes-block SAID"
            },
            "i": {
              "type": "string",
              "description": "Holder AID prefix (scope hosting the intent)"
            },
            "dt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 issuance timestamp"
            },
            "intent-id": {
              "type": "string"
            },
            "action": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "receiver": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource-conforms-to": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource-classified-as": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "resource-quantity": {
              "type": [
                "array",
                "null"
              ],
              "description": "(qty . unit) pair"
            },
            "effort-quantity": {
              "type": [
                "array",
                "null"
              ],
              "description": "(qty . unit) pair"
            },
            "available-quantity": {
              "type": [
                "array",
                "null"
              ]
            },
            "minimum-quantity": {
              "type": [
                "array",
                "null"
              ]
            },
            "due": {
              "type": [
                "string",
                "null"
              ]
            },
            "plan-id": {
              "type": [
                "string",
                "null"
              ]
            },
            "process-id": {
              "type": [
                "string",
                "null"
              ]
            },
            "satisfies": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "d",
            "i",
            "dt",
            "intent-id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "e": {
      "oneOf": [
        {
          "type": "string",
          "description": "Edge-block SAID (compact form)"
        },
        {
          "type": "object",
          "description": "ACDC edge block: named edges to other credentials",
          "properties": {
            "d": {
              "type": "string",
              "description": "Edge-block SAID"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "v",
    "d",
    "i",
    "ri",
    "s",
    "a"
  ],
  "additionalProperties": false
}
