;;; gen-kernels.scm — emit kernel_kinds.h from tension-kinds.scm's *kind-spec*.
;;;
;;; The same spec that builds the Scheme closures is compiled to C here, so the
;;; compiled backend's per-kind math is GENERATED, not hand-maintained. Adding a
;;; kind = one spec row + regenerate + recompile; test-tension-parity.scm then
;;; pins C ≡ Scheme bit-for-bit.
;;;
;;; Run:  guile -L module module/playnet/planner/solve/kernel/gen-kernels.scm  (writes kernel_kinds.h)

(use-modules (srfi srfi-1) (ice-9 format))
(use-modules (playnet planner formulas tension-kinds))

(define (cnum x) (number->string (exact->inexact x)))
(define (join sep xs)                          ; n-ary infix without assuming string-join
  (if (null? xs) "" (fold-right (lambda (x a) (if (string=? a "") x (string-append x sep a))) "" xs)))
(define (->c e)                                ; sexp over (s t D w) → fully-parenthesised C
  (cond
    ((number? e) (cnum e))
    ((symbol? e) (symbol->string e))           ; s t D w
    ((pair? e)
     (let ((op (car e)) (a (cdr e)))
       (case op
         ((if)  (string-append "(" (->c (car a)) " ? " (->c (cadr a)) " : " (->c (caddr a)) ")"))
         ((<)   (string-append "(" (->c (car a)) " < " (->c (cadr a)) ")"))
         ((>)   (string-append "(" (->c (car a)) " > " (->c (cadr a)) ")"))
         ((log) (string-append "log(" (->c (car a)) ")"))
         ((exp) (string-append "exp(" (->c (car a)) ")"))
         ((sq)  (string-append "(" (->c (car a)) "*" (->c (car a)) ")"))
         ((-)   (if (null? (cdr a)) (string-append "(-" (->c (car a)) ")")
                    (string-append "(" (->c (car a)) " - " (->c (cadr a)) ")")))
         ((+)   (string-append "(" (join " + " (map ->c a)) ")"))
         ((*)   (string-append "(" (join " * " (map ->c a)) ")"))
         ((/)   (string-append "(" (->c (car a)) " / " (->c (cadr a)) ")"))
         (else  (error "gen-kernels: unknown op" op)))))
    (else (error "gen-kernels: bad expr" e))))

(define (fn name field)
  (string-append
   "static inline double " name "(int k, double s, double t, double D, double w){\n"
   "  switch(k){\n"
   (string-concatenate
    (map (lambda (e) (format #f "    case ~a: return ~a;\n" (spec-code e) (->c (field e)))) *kind-spec*))
   "    default: return 0.0;\n  }\n}\n"))

(define header
  (string-append
   "/* kernel_kinds.h — GENERATED by gen-kernels.scm from tension-kinds.scm *kind-spec*.\n"
   " * Do NOT edit by hand. Regenerate: guile -L module module/playnet/planner/solve/kernel/gen-kernels.scm\n"
   " * One source of truth for per-kind term math, shared with the Scheme closures\n"
   " * in tension-kinds.scm and verified bit-for-bit by test-tension-parity.scm. */\n"
   "#include <math.h>\n\n"
   (fn "pk_kind_value" spec-value) "\n"
   (fn "pk_kind_grad"  spec-grad)  "\n"
   (fn "pk_kind_curv"  spec-curv)))

;; (current-filename) is #f whenever this file is reached through a -L load
;; path, which is every documented way of running it — so `(dirname
;; (current-filename))` raised "Wrong type argument … #f" before writing
;; anything, and the header this script exists to generate could only ever have
;; been produced by hand. Same fallback chain the rest of the planner uses.
(define out
  (string-append
   (dirname (or (current-filename)
                (find (lambda (p) (and (string? p) (string-suffix? "gen-kernels.scm" p)))
                      (command-line))
                "module/playnet/planner/solve/kernel/gen-kernels.scm"))
   "/kernel_kinds.h"))
(call-with-output-file out (lambda (p) (display header p)))
(format #t "wrote ~a (~a kinds)\n" out (length *kind-spec*))
