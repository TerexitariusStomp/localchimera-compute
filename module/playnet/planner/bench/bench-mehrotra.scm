;;; bench-mehrotra.scm — VALIDATED dense primal-dual Mehrotra predictor-corrector.
;;; Proves the iteration-count win on our actual program before the matrix-free C port:
;;; degenerate located grid converges in ~12 iters vs the primal path-follower's 224
;;; (~18x fewer outer steps, same met, gap-certified mu->0). The C port reuses the
;;; matrix-free Hv (cv=y/s for bar terms) + CG; this dense version is for validation.
;;; Dense primal-dual Mehrotra predictor-corrector prototype (validation only).
;;; min f(x)  s.t.  s = A x + c >= 0,  where f = Σ_desire + κ·labour (smooth obj).
;;; Goal: count OUTER iterations vs the primal path-following solver on the same problem.
(use-modules (srfi srfi-1) (ice-9 format))
(use-modules (playnet planner solve engine)
             (playnet planner solve solver))

;; small located grid
(define (build-grid P T)
  (declare-world! #:places (map (lambda (i) (list (format #f "p~a" i) 0.0 (* 0.01 i))) (iota P))
                  #:periods (iota T) #:templates *base-templates*
                  #:storable '("bread") #:movable '("grain") #:tau 0.001 #:hold 0.001
                  #:neighbours (map (lambda (i) (cons (format #f "p~a" i)
                                                      (filter (lambda (x) x) (list (and (> i 0) (format #f "p~a" (- i 1)))
                                                                                   (and (< i (- P 1)) (format #f "p~a" (+ i 1)))))))
                                    (iota P)))
  (for-each (lambda (pl) (for-each (lambda (t) (let ((c (cell pl t))) (hash-set! *cap* (lg "soil" c) 1000.0) (hash-set! *A* c 1000.0) (hash-set! *demand* (lg "bread" c) 10.0))) *periods*)) *places*))

;; dense linear solve (Gaussian elimination, partial pivot)
(define (gsolve M b n)
  (let ((A (make-vector n)) (x (make-vector n 0.0)))
    (do ((i 0 (+ i 1))) ((= i n)) (let ((row (make-vector (+ n 1)))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! row j (vector-ref (vector-ref M i) j))) (vector-set! row n (vector-ref b i)) (vector-set! A i row)))
    (do ((c 0 (+ c 1))) ((= c n))
      (let ((piv c)) (do ((r (+ c 1) (+ r 1))) ((= r n)) (when (> (abs (vector-ref (vector-ref A r) c)) (abs (vector-ref (vector-ref A piv) c))) (set! piv r)))
        (let ((tmp (vector-ref A c))) (vector-set! A c (vector-ref A piv)) (vector-set! A piv tmp))
        (let ((d (vector-ref (vector-ref A c) c)))
          (do ((r (+ c 1) (+ r 1))) ((= r n))
            (let ((f (/ (vector-ref (vector-ref A r) c) (if (= d 0.0) 1e-30 d))))
              (do ((j c (+ j 1))) ((> j n)) (vector-set! (vector-ref A r) j (- (vector-ref (vector-ref A r) j) (* f (vector-ref (vector-ref A c) j))))))))))
    (do ((c (- n 1) (- c 1))) ((< c 0) x)
      (let ((s (vector-ref (vector-ref A c) n)))
        (do ((j (+ c 1) (+ j 1))) ((= j n)) (set! s (- s (* (vector-ref (vector-ref A c) j) (vector-ref x j)))))
        (vector-set! x c (/ s (let ((d (vector-ref (vector-ref A c) c))) (if (= d 0.0) 1e-30 d))))))))

;; extract: bar rows (constraints), des/qc terms (objective), from forms
(define (run-mehrotra P T)
  (build-grid P T)
  (call-with-values build-located (lambda (forms labform ncol cols goods raws idx)
    (let* ((C (flatten forms)) (n ncol)
           (bars '()) (objs '()))   ; bars: (const . coeffs); objs: (kind const coeffs D w)
      (for-each (lambda (f)
        (case (car f)
          ((bar) (set! bars (cons (cons (cadr f) (caddr f)) bars)))
          ((des) (set! objs (cons (list 'des (cadr f) (caddr f) (car (cadddr f)) (cdr (cadddr f))) objs)))
          ((qc)  (set! objs (cons (list 'qc (cadr f) (caddr f) 0.0 (cadddr f)) objs)))))
        forms)
      (set! bars (list->vector bars)) (set! objs (list->vector objs))
      (let* ((m (vector-length bars)) (no (vector-length objs))
             (kap (exact->inexact *kappa*))
             (lab (map (lambda (ic) (cons (car ic) (exact->inexact (cdr ic)))) labform)))
        (define (slack-bar bi x) (let ((b (vector-ref bars bi))) (fold (lambda (vc a) (+ a (* (cdr vc) (vector-ref x (car vc))))) (car b) (cdr b))))
        ;; --- build dense M, ∇f, Aᵀy etc. ---
        (define (objgrad x)   ; ∇f_obj = Σ obj-grad·a + κ lab
          (let ((g (make-vector n 0.0)))
            (do ((oi 0 (+ oi 1))) ((= oi no))
              (let* ((o (vector-ref objs oi)) (coeffs (caddr o)) (s (fold (lambda (vc a)(+ a (* (cdr vc)(vector-ref x (car vc))))) (cadr o) coeffs)))
                (let ((gc (cond ((eq? (car o) 'des) (let ((D (cadddr o))(w (list-ref o 4))) (if (< s D) (/ (* -2.0 w (- D s)) (* D D)) 0.0)))
                                ((eq? (car o) 'qc) (* 2.0 (list-ref o 4) s)) (else 0.0))))
                  (unless (= gc 0.0) (for-each (lambda (vc) (vector-set! g (car vc) (+ (vector-ref g (car vc)) (* gc (cdr vc))))) coeffs)))))
            (for-each (lambda (ic) (vector-set! g (car ic) (+ (vector-ref g (car ic)) (* kap (cdr ic))))) lab)
            g))
        (define (objHess)   ; ∇²f_obj diag-ish dense (small)
          (let ((H (make-vector n))) (do ((i 0 (+ i 1)))((= i n))(vector-set! H i (make-vector n 0.0)))
            (do ((oi 0 (+ oi 1)))((= oi no))
              (let* ((o (vector-ref objs oi)) (coeffs (caddr o)))
                (let ((cu (cond ((eq?(car o)'des)(let((D(cadddr o))(w(list-ref o 4)))(/(* 2.0 w)(* D D))))((eq?(car o)'qc)(* 2.0 (list-ref o 4)))(else 0.0))))
                  (unless (= cu 0.0) (for-each (lambda (a) (for-each (lambda (b) (vector-set!(vector-ref H (car a))(car b)(+(vector-ref(vector-ref H(car a))(car b))(* cu(cdr a)(cdr b))))) coeffs) ) coeffs)))))
            H))
        (define (addAtYSA! H s y)  ; H += Σ_bar (y/s) a aᵀ
          (do ((bi 0 (+ bi 1)))((= bi m))
            (let* ((b (vector-ref bars bi)) (coeffs (cdr b)) (ys (/ (vector-ref y bi)(max 1e-12 (vector-ref s bi)))))
              (for-each (lambda (a)(for-each (lambda (c)(vector-set!(vector-ref H(car a))(car c)(+(vector-ref(vector-ref H(car a))(car c))(* ys(cdr a)(cdr c))))) coeffs)) coeffs))))
        (define (Aty v)  ; Σ_bar v[bi]·a_bi  → length n
          (let ((o (make-vector n 0.0))) (do ((bi 0 (+ bi 1)))((= bi m))(for-each (lambda (vc)(vector-set! o (car vc)(+(vector-ref o(car vc))(*(vector-ref v bi)(cdr vc))))) (cdr (vector-ref bars bi)))) o))
        (define (Adx dx) ; (A dx)_bi = Σ val·dx  (no const)
          (let ((o (make-vector m 0.0))) (do ((bi 0 (+ bi 1)))((= bi m))(vector-set! o bi (fold (lambda (vc a)(+ a (*(cdr vc)(vector-ref dx (car vc))))) 0.0 (cdr(vector-ref bars bi))))) o))
        (define (bar-slacks x)(let((s(make-vector m 0.0)))(do((bi 0(+ bi 1)))((= bi m) s)(vector-set! s bi (slack-bar bi x)))))
        (define (ftb v dv)  ; max α∈[0,1]: v+α dv ≥ 0
          (let ((a 1.0))(do((i 0(+ i 1)))((= i (vector-length v)) a)(when(< (vector-ref dv i) 0.0)(set! a (min a (/ (vector-ref v i)(- (vector-ref dv i)))))))))
        ;; --- init: feasible x (ensure-feasible), y = μ/s ---
        (let* ((xf (ensure-feasible forms labform (located-warm cols ncol idx) solve-native-c-core))
               (x (let ((v (make-vector n))) (do ((i 0(+ i 1)))((= i n) v)(vector-set! v i (vector-ref xf i)))))
               (s (bar-slacks x))
               (y (make-vector m 1.0)))
          (let loop ((it 0))
            (let ((mu (/ (let ((a 0.0))(do((bi 0(+ bi 1)))((= bi m) a)(set! a (+ a (* (vector-ref s bi)(vector-ref y bi))))) ) (max 1 m))))
              (if (or (>= it 60) (< mu 1e-6))
                  (begin (format #t "  ~ax~a  n=~a m=~a  MEHROTRA iters=~a  mu=~,2e  met=~,2f%~%" P T n m (+ it 1) mu (* 100. (mean-fill C x))))
                  (let* ((gf (objgrad x))
                         (H (objHess)) (_ (addAtYSA! H s y))
                         (negf (let ((v (make-vector n)))(do((i 0(+ i 1)))((= i n) v)(vector-set! v i (- (vector-ref gf i))))))
                         (dxa (gsolve H negf n))
                         (dsa (Adx dxa))
                         (dya (let ((v (make-vector m)))(do((bi 0(+ bi 1)))((= bi m) v)(vector-set! v bi (- (- (vector-ref y bi)) (* (/ (vector-ref y bi)(max 1e-12(vector-ref s bi)))(vector-ref dsa bi)))))))
                         (aaf (min (ftb s dsa)(ftb y dya)))
                         (muaf (/ (let((a 0.0))(do((bi 0(+ bi 1)))((= bi m) a)(set! a (+ a (* (+(vector-ref s bi)(* aaf(vector-ref dsa bi)))(+(vector-ref y bi)(* aaf(vector-ref dya bi)))))))) (max 1 m)))
                         (sig (let ((r (/ muaf (max 1e-30 mu)))) (* r r r)))
                         ;; corrector RHS = -∇f - Aᵀ((dsa⊙dya)/s) + σμ Aᵀ(1/s)
                         (cc (let ((v (make-vector m)))(do((bi 0(+ bi 1)))((= bi m) v)(vector-set! v bi (- (/ (* (vector-ref dsa bi)(vector-ref dya bi))(max 1e-12(vector-ref s bi))) (/ (* sig mu)(max 1e-12(vector-ref s bi))))))))
                         (rhs (let ((atc (Aty cc)) (v (make-vector n)))(do((i 0(+ i 1)))((= i n) v)(vector-set! v i (- (- (vector-ref gf i))(vector-ref atc i))))))
                         (dx (gsolve H rhs n))
                         (ds (Adx dx))
                         (dy (let ((v (make-vector m)))(do((bi 0(+ bi 1)))((= bi m) v)(vector-set! v bi (/ (- (- (+ (* (vector-ref s bi)(vector-ref y bi))(* (vector-ref dsa bi)(vector-ref dya bi))(- (* sig mu)))) (* (vector-ref y bi)(vector-ref ds bi))) (max 1e-12(vector-ref s bi)))))))
                         (al (* 0.99 (min (ftb s ds)(ftb y dy) 1.0))))
                    (do((i 0(+ i 1)))((= i n))(vector-set! x i (+ (vector-ref x i)(* al(vector-ref dx i)))))
                    (set! s (bar-slacks x))
                    (do((bi 0(+ bi 1)))((= bi m))(vector-set! y bi (max 1e-12 (+ (vector-ref y bi)(* al(vector-ref dy bi))))))
                    (loop (+ it 1))))))))))))

(define (primal-iters P T)
  (build-grid P T)
  (call-with-values build-located (lambda (forms lf ncol cols g r idx)
    (set! *kern-mettol* 0.0)
    (call-with-values (lambda () (solve-native-c-core forms lf (ensure-feasible forms lf (located-warm cols ncol idx) solve-native-c-core)))
      (lambda (x t cg nt cv) (format #t "  ~ax~a  PRIMAL path-follow Newton=~a  met=~,2f%~%" P T nt (* 100. (mean-fill (flatten forms) x))))))))
(format #t "~%==== Mehrotra predictor-corrector vs primal (outer iterations) ====~%")
(primal-iters 3 2) (run-mehrotra 3 2)
(primal-iters 4 3) (run-mehrotra 4 3)
