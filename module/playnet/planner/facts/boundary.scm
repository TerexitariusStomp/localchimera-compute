;;; boundary.scm — the flows nothing makes: the system's edge.
;;;
;;; The sky's gifts (light, water, the air's carbon dioxide and oxygen) and the
;;; surroundings' warmth arrive at every scope without a recipe. The solve reads
;;; them as raw supply wherever nothing produces them, and the chemistry layer
;;; reads them as the carriers at the system's edge, so the list stands below
;;; both.

(define-module (playnet planner facts boundary)
  #:export (*ambient-flows*))

(define *ambient-flows* '("sunlight" "rain" "co2" "o2" "ambient-heat"))
