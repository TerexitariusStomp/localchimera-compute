{
  "$id": "ELffa6xeJYBUL7cGl1-F95s_O9i-1n5P30AH4XtaI6gK",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playnet Governor Credential",
  "description": "Credential asserting that the holder is a governor (governance participant) in playnet.",
  "type": "object",
  "credentialType": "PlaynetGovernorCredential",
  "version": "1.0.0",
  "properties": {
    "v": {
      "type": "string",
      "description": "ACDC version string"
    },
    "d": {
      "type": "string",
      "description": "Credential SAID"
    },
    "u": {
      "type": "string",
      "description": "Optional salt for privacy-preserving presentations"
    },
    "i": {
      "type": "string",
      "description": "Issuer AID prefix"
    },
    "ri": {
      "type": "string",
      "description": "Registry identifier (TEL)"
    },
    "s": {
      "type": "string",
      "description": "Schema SAID"
    },
    "a": {
      "oneOf": [
        {
          "type": "string",
          "description": "Attributes-block SAID (compact form)"
        },
        {
          "type": "object",
          "properties": {
            "d": {
              "type": "string",
              "description": "Attributes-block SAID"
            },
            "i": {
              "type": "string",
              "description": "Holder AID prefix"
            },
            "dt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 issuance timestamp"
            }
          },
          "required": [
            "d",
            "i",
            "dt"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "d",
    "i",
    "ri",
    "s",
    "a"
  ],
  "additionalProperties": false
}
