;;; ingest-test.scm — REAL DATA: plan over the codebase's actual recipe knowledge.
;;;
;;; Not hand-built bread. This loads module/playnet/knowledge/recipes/
;;; federation.scm — the real ValueFlows recipe records the rest of the system
;;; uses — by mocking the recipe store to harvest them, compiles them into the
;;; activity matrix (signs from the standard action table; labour from each
;;; process's has-duration, since these recipes carry no explicit work-flow), and
;;; solves a plan with the certified interior-point engine. Proves the planner is
;;; a function of the real ontology, end to end.
;;;
;;; Run:  guile -L module module/playnet/planner/ingest-test.scm

(use-modules (srfi srfi-1) (ice-9 format))
(use-modules (playnet vf schemas))

;; ── harvest the REAL records from the recipe store ───────────────────────────
(define *procs* '()) (define *flows* '()) (define *specs* '())
(define (mock-store)
  (lambda (msg . args)
    (case msg
      ((add-recipe-process) (set! *procs* (cons (car args) *procs*)))
      ((add-recipe-flow)    (set! *flows* (cons (car args) *flows*)))
      ((add-resource-spec)  (set! *specs* (cons (car args) *specs*)))
      (else #t))))
(define ($ obj msg . args) (apply obj msg args))
(define store (mock-store))
(primitive-load (string-append (getcwd) "/module/playnet/knowledge/recipes/federation.scm"))
(seed-federation-specs store)
(seed-federation-recipes store)

;; ── compile a RecipeProcess + its flows → an activity (action table for signs;
;;    labour from has-duration when there is no work-flow) ─────────────────────
(define (mqty m) (if m (measure-has-numerical-value m) 0.0))
(define (action-def a) (let ((p (assq a *action-definitions*))) (and p (cdr p))))
(define (compile-process rp flows)        ; → (id outputs inputs labour) ; out/in = alist (spec . qty)
  (let ((outputs '()) (inputs '()) (labour 0.0))
    (let ((d (recipe-process-has-duration rp))) (when d (set! labour (duration-has-numerical-value d))))
    (for-each
     (lambda (rf)
       (let ((action (recipe-flow-action rf)) (spec (recipe-flow-resource-conforms-to rf))
             (rq (mqty (recipe-flow-resource-quantity rf))) (eff (mqty (recipe-flow-effort-quantity rf)))
             (ad (action-def (recipe-flow-action rf))))
         (cond ((eq? action 'work) (set! labour (+ labour eff)))
               ((and ad (eq? (action-definition-onhand-effect ad) 'increment)) (set! outputs (acons spec rq outputs)))
               ((and ad (eq? (action-definition-onhand-effect ad) 'decrement)) (set! inputs (acons spec rq inputs)))
               (else #t))))
     flows)
    (list (recipe-process-id rp) outputs inputs labour)))
(define (p-id c) (car c)) (define (p-out c) (cadr c)) (define (p-in c) (caddr c)) (define (p-lab c) (cadddr c))
(define *templates*
  (map (lambda (rp)
         (compile-process rp (filter (lambda (rf) (or (equal? (recipe-flow-recipe-input-of rf) (recipe-process-id rp))
                                                      (equal? (recipe-flow-recipe-output-of rf) (recipe-process-id rp)))) *flows*)))
       (reverse *procs*)))
(define *specname* (let ((h (make-hash-table))) (for-each (lambda (s) (hash-set! h (resource-specification-id s) (resource-specification-name s))) *specs*) h))
(define (sname id) (or (hash-ref *specname* id) id))

;; goods (output by some process) vs raws (only consumed)
(define *made* (delete-duplicates (append-map (lambda (c) (map car (p-out c))) *templates*)))
(define *allspec* (delete-duplicates (append-map (lambda (c) (append (map car (p-out c)) (map car (p-in c)))) *templates*)))
(define *raws* (filter (lambda (s) (not (member s *made*))) *allspec*))

;; ── CSR convex engine (compact copy of scale-test's) ─────────────────────────
(define (vdot a b) (let ((s 0.0) (n (vector-length a))) (do ((i 0 (+ i 1))) ((= i n) s) (set! s (+ s (* (vector-ref a i) (vector-ref b i)))))))
(define (vcopy a) (let* ((n (vector-length a)) (r (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) r) (vector-set! r i (vector-ref a i)))))
(define (mk-bar const coeffs) (list 'bar const coeffs #f))
(define (mk-des form D w)     (list 'des (cadr form) (caddr form) (cons D w)))
(define (f-kind f) (car f)) (define (f-const f) (cadr f)) (define (f-coeffs f) (caddr f)) (define (f-Dw f) (cadddr f))
(define (cnt c)(vector-ref c 0))(define (cptr c)(vector-ref c 2))(define (cconst c)(vector-ref c 3))(define (ckind c)(vector-ref c 4))
(define (cD c)(vector-ref c 5))(define (cw c)(vector-ref c 6))(define (cidx c)(vector-ref c 7))(define (cval c)(vector-ref c 8))
(define (flatten forms)
  (let* ((nt (length forms)) (nnz (fold (lambda (f a) (+ a (length (f-coeffs f)))) 0 forms))
         (ptr (make-vector (+ nt 1) 0)) (const (make-vector nt 0.0)) (kind (make-vector nt 0))
         (D (make-vector nt 1.0)) (w (make-vector nt 0.0)) (idx (make-vector (max 1 nnz) 0)) (val (make-vector (max 1 nnz) 0.0)))
    (let loop ((fs forms) (ti 0) (off 0))
      (if (null? fs) (begin (vector-set! ptr nt off) (vector nt nnz ptr const kind D w idx val))
          (let ((f (car fs)))
            (vector-set! ptr ti off) (vector-set! const ti (f-const f))
            (when (eq? (f-kind f) 'des) (vector-set! kind ti 1) (vector-set! D ti (car (f-Dw f))) (vector-set! w ti (cdr (f-Dw f))))
            (let put ((cs (f-coeffs f)) (o off))
              (if (null? cs) (loop (cdr fs) (+ ti 1) o) (begin (vector-set! idx o (caar cs)) (vector-set! val o (cdar cs)) (put (cdr cs) (+ o 1))))))))))
(define *kappa* 0.02)
(define (term-values C x)
  (let* ((nt (cnt C)) (ptr (cptr C)) (idx (cidx C)) (val (cval C)) (sv (make-vector nt 0.0)))
    (do ((ti 0 (+ ti 1))) ((= ti nt) sv) (let ((s (vector-ref (cconst C) ti)))
      (do ((k (vector-ref ptr ti) (+ k 1))) ((= k (vector-ref ptr (+ ti 1)))) (set! s (+ s (* (vector-ref val k) (vector-ref x (vector-ref idx k))))))
      (vector-set! sv ti s)))))
(define (term-coeffs C t sv)
  (let* ((nt (cnt C)) (cv (make-vector nt 0.0)))
    (do ((ti 0 (+ ti 1))) ((= ti nt) cv) (let ((s (vector-ref sv ti)))
      (if (= (vector-ref (ckind C) ti) 1)
          (when (< s (vector-ref (cD C) ti)) (let ((Dd (vector-ref (cD C) ti))) (vector-set! cv ti (/ (* 2.0 (vector-ref (cw C) ti)) (* Dd Dd)))))
          (when (> s 1e-12) (vector-set! cv ti (/ t (* s s)))))))))
(define (csr-hv C cv v n)
  (let ((r (make-vector n 0.0)) (ptr (cptr C)) (idx (cidx C)) (val (cval C)) (nt (cnt C)))
    (do ((ti 0 (+ ti 1))) ((= ti nt)) (let ((c (vector-ref cv ti))) (unless (= c 0.0)
      (let ((dot 0.0) (lo (vector-ref ptr ti)) (hi (vector-ref ptr (+ ti 1))))
        (do ((k lo (+ k 1))) ((= k hi)) (set! dot (+ dot (* (vector-ref val k) (vector-ref v (vector-ref idx k))))))
        (let ((cd (* c dot))) (do ((k lo (+ k 1))) ((= k hi)) (let ((i (vector-ref idx k))) (vector-set! r i (+ (vector-ref r i) (* cd (vector-ref val k)))))))))))
    (do ((i 0 (+ i 1))) ((= i n)) (vector-set! r i (+ (vector-ref r i) (* 1e-7 (vector-ref v i))))) r))
(define (csr-diag C cv n)
  (let ((d (make-vector n 1e-7)) (ptr (cptr C)) (idx (cidx C)) (val (cval C)) (nt (cnt C)))
    (do ((ti 0 (+ ti 1))) ((= ti nt)) (let ((c (vector-ref cv ti))) (unless (= c 0.0)
      (do ((k (vector-ref ptr ti) (+ k 1))) ((= k (vector-ref ptr (+ ti 1)))) (let ((i (vector-ref idx k)) (vk (vector-ref val k))) (vector-set! d i (+ (vector-ref d i) (* c vk vk)))))))) d))
(define (csr-grad C labform t sv n)
  (let ((g (make-vector n 0.0)) (ptr (cptr C)) (idx (cidx C)) (val (cval C)) (nt (cnt C)))
    (do ((ti 0 (+ ti 1))) ((= ti nt)) (let ((s (vector-ref sv ti)))
      (if (= (vector-ref (ckind C) ti) 1)
          (let ((Dd (vector-ref (cD C) ti)) (ww (vector-ref (cw C) ti))) (when (< s Dd) (let ((gc (/ (* -2.0 ww (- Dd s)) (* Dd Dd))))
            (do ((k (vector-ref ptr ti) (+ k 1))) ((= k (vector-ref ptr (+ ti 1)))) (let ((i (vector-ref idx k))) (vector-set! g i (+ (vector-ref g i) (* gc (vector-ref val k)))))))))
          (when (> s 1e-12) (let ((gc (/ t s))) (do ((k (vector-ref ptr ti) (+ k 1))) ((= k (vector-ref ptr (+ ti 1)))) (let ((i (vector-ref idx k))) (vector-set! g i (- (vector-ref g i) (* gc (vector-ref val k)))))))))))
    (for-each (lambda (ic) (vector-set! g (car ic) (+ (vector-ref g (car ic)) (* *kappa* (cdr ic))))) labform) g))
(define (obj-value C labform t x sv)
  (let ((acc (fold (lambda (ic a) (+ a (* *kappa* (cdr ic) (vector-ref x (car ic))))) 0.0 labform)) (nt (cnt C)))
    (do ((ti 0 (+ ti 1))) ((= ti nt) acc) (let ((s (vector-ref sv ti)))
      (if (= (vector-ref (ckind C) ti) 1) (let ((Dd (vector-ref (cD C) ti))) (when (< s Dd) (set! acc (+ acc (* (vector-ref (cw C) ti) (expt (/ (- Dd s) Dd) 2))))))
          (set! acc (+ acc (if (<= s 1e-12) 1e12 (* (- t) (log s))))))))))
(define (pcg C cv b diag n)
  (let* ((x (make-vector n 0.0)) (r (vcopy b))
         (z (let ((v (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) v) (vector-set! v i (/ (vector-ref r i) (vector-ref diag i)))))) (p (vcopy z)))
    (let loop ((k 0) (rz (vdot r z)))
      (if (or (>= k (min 300 (+ n 2))) (< (vdot r r) 1e-16)) x
          (let* ((Hp (csr-hv C cv p n)) (al (/ rz (max 1e-30 (vdot p Hp)))))
            (do ((i 0 (+ i 1))) ((= i n)) (vector-set! x i (+ (vector-ref x i) (* al (vector-ref p i)))) (vector-set! r i (- (vector-ref r i) (* al (vector-ref Hp i)))))
            (let* ((z2 (let ((v (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) v) (vector-set! v i (/ (vector-ref r i) (vector-ref diag i)))))) (rz2 (vdot r z2)))
              (do ((i 0 (+ i 1))) ((= i n)) (vector-set! p i (+ (vector-ref z2 i) (* (/ rz2 rz) (vector-ref p i))))) (loop (+ k 1) rz2)))))))
(define (solve C labform x0)
  (let ((n (vector-length x0)))
    (let path ((t 1.0) (x x0))
      (let newton ((it 0) (x x))
        (let* ((sv (term-values C x)) (g (csr-grad C labform t sv n)) (gn (sqrt (vdot g g))))
          (if (or (>= it 40) (< gn 1e-6)) (if (<= t 0.02) (values x t) (path (max 0.02 (* t 0.5)) x))
              (let* ((cv (term-coeffs C t sv)) (negg (let ((v (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! v i (- (vector-ref g i)))) v))
                     (d (pcg C cv negg (csr-diag C cv n) n)) (f0 (obj-value C labform t x sv)))
                (let ls ((eta 1.0))
                  (let* ((y (let ((v (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! v i (+ (vector-ref x i) (* eta (vector-ref d i))))) v)) (fy (obj-value C labform t y (term-values C y))))
                    (cond ((and (< fy 1e11) (< fy (- f0 1e-9))) (newton (+ it 1) y))
                          ((< eta 1e-9) (if (<= t 0.02) (values x t) (path (max 0.02 (* t 0.5)) x)))
                          (else (ls (* eta 0.5)))))))))))))

;; ── build a one-scope plan from the real recipes, and solve ──────────────────
;; activity index = process index; goods indexed after. delivered(spec) ≥ 0;
;; demand on the finals we ask for; raw caps; one labour pool.
(define *demand* (list (cons "spec-bread" 100.0) (cons "spec-cheese" 40.0)))
(define (run)
  (let* ((np (length *templates*))
         (gidx (make-hash-table)) (ng 0)
         (g! (lambda (s) (or (hash-ref gidx s) (let ((i ng)) (set! ng (+ ng 1)) (hash-set! gidx s i) i))))
         (flowsby (make-hash-table)))      ; spec -> list (activity . coeff)
    ;; activity a = process a ; record its flows on goods
    (let ((ai 0))
      (for-each (lambda (tpl)
                  (for-each (lambda (oq) (hash-set! flowsby (car oq) (cons (cons ai (cdr oq)) (hash-ref flowsby (car oq) '())))) (p-out tpl))
                  (for-each (lambda (iq) (hash-set! flowsby (car iq) (cons (cons ai (- (cdr iq))) (hash-ref flowsby (car iq) '())))) (p-in tpl))
                  (set! ai (+ ai 1)))
                *templates*))
    (let ((forms '()) (labform '()) (n np))
      ;; delivered ≥ 0 for every produced spec; demand on the asked finals
      (for-each (lambda (s)
                  (let* ((coeffs (hash-ref flowsby s '())) (dem (assoc s *demand*)))
                    (set! forms (cons (mk-bar 0.0 coeffs) forms))
                    (when dem (set! forms (cons (mk-des (mk-bar 0.0 coeffs) (cdr dem) 1000.0) forms)))))
                *made*)
      ;; raw caps (ample) ; eco slack = cap + Σflow·x, flow negative
      (for-each (lambda (s) (set! forms (cons (mk-bar 1e6 (hash-ref flowsby s '())) forms))) *raws*)
      ;; one labour pool
      (let ((lc '()) (ai 0))
        (for-each (lambda (tpl) (when (> (p-lab tpl) 0.0) (set! lc (cons (cons ai (p-lab tpl)) lc))) (set! ai (+ ai 1))) *templates*)
        (set! forms (cons (mk-bar 1e6 (map (lambda (al) (cons (car al) (- (cdr al)))) lc)) forms))
        (set! labform lc))
      ;; activity ≥ 0
      (do ((ai 0 (+ ai 1))) ((= ai n)) (set! forms (cons (mk-bar 0.0 (list (cons ai 1.0))) forms)))
      (let ((C (flatten forms)) (x0 (make-vector n 10.0)))   ; warm: 10 runs each (feasible, ample caps)
        (call-with-values (lambda () (solve C labform x0))
          (lambda (x t)
            (format #t "~%==== PLAN over REAL federation recipes (~a processes, ~a goods, ~a raws) ====~%" np (length *made*) (length *raws*))
            (format #t "   process runs:~%")
            (let ((ai 0)) (for-each (lambda (tpl)
                (format #t "     ~10a ~6,1f runs  (~,1f h)  ->~a~%" (p-id tpl) (vector-ref x ai) (* (vector-ref x ai) (p-lab tpl))
                        (string-concatenate (map (lambda (oq) (format #f "  ~a ~,1f" (sname (car oq)) (* (vector-ref x ai) (cdr oq)))) (p-out tpl))))
                (set! ai (+ ai 1))) *templates*))
            (format #t "   total labour: ~,1f h~%" (fold (lambda (ic a) (+ a (* (cdr ic) (vector-ref x (car ic))))) 0.0 labform))
            (for-each (lambda (dc)
                        (let* ((coeffs (hash-ref flowsby (car dc) '())) (dlv (fold (lambda (ac a) (+ a (* (cdr ac) (vector-ref x (car ac))))) 0.0 coeffs)))
                          (format #t "   demand ~a: ~,1f / ~a  (~,0f%% met)~%" (sname (car dc)) dlv (cdr dc) (* 100.0 (min 1.0 (/ dlv (cdr dc)))))))
                      *demand*)
            (newline)))))))
(run)
