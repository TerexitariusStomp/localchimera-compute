;;; bay-area.scm — the San Francisco Bay Area bioregion as a first-class ecological
;;; agent, the FOURTH real shed (after doon, cascadia, berlin). California's
;;; Mediterranean climate makes this the water-fragility shed: a wet winter, a
;;; bone-dry summer, and the most water-stressed basin of any we carry — the real
;;; backdrop to the state's chronic drought. Nothing here is bespoke machinery; it
;;; is DATA assembled onto the <bioregion> container (bioregions.scm), inherited by
;;; any scope placed contained-in it via the same containment walk the others use.
;;;
;;; Loaded after planner.scm (make-planning-scenario, make-bioregion,
;;; register-bioregion!, assemble-scenarios). Provides *bay-area* (a <bioregion>) +
;;; its scenario/yield sets + *bay-area-shed-spatials* (biosphere ⊃ shed ⊃ SF ⊃ …)
;;; for the SF / Oakland subscopes placed within it.
;;;
;;; ── PROVENANCE (data/sources.md) ───────────────────────────────────────────────
;;; [DATA]  Climate — ERA5 via Open-Meteo, the Bay's OWN 1960–2023 record
;;;   (data/raw/bay-area): growing season AUTO-detected as the WINTER wet months
;;;   (Nov–Mar) — Mediterranean, no agronomic input; normal-season rain only ~383 mm
;;;   (drought 171 / flood 672). drought 0.14 / normal 0.72 / flood 0.14 (±1σ).
;;;   Warming +0.64 °C/60 yr (coastal moderation — the mildest of the sheds).
;;; [DERIVED] Multipliers — FAO Ky × the local winter rainfall: a dry summer on
;;;   irrigation-dependent crops makes the drought bite HARDEST of any shed
;;;   (tomato 0.45, potato 0.39, beans/peas 0.36) — the fragility the robust plan hedges.
;;; [DATA]  Yields — US national (OWID/FAOSTAT): the market-garden set (tomato 97.6,
;;;   potato 50.6, bean 2.2, pea 2.0 t/ha). California-specific is the W2 refinement.
;;; [DATA]  Fragility STATE — water is real and EXTREME here:
;;;   · water — WRI Aqueduct baseline water stress 0.97 ("Extremely high", >80%),
;;;     overall risk "extremely high", seasonal variability high (process-water.scm):
;;;     the summer-dry, over-allocated California water the whole plan turns on.
;;; [DRAFT] · topsoil — SoilGrids v2.0 was MASKED at the coastal/urban point and the
;;;   nearest tilled cells throttled to null on this pull, so the SOC state is
;;;   transcription-tier: ~12 g/kg, the low end typical of Mediterranean California
;;;   cropland (to be RATIFIED, like the eco-catalogue's planetary boundaries). The
;;;   envelope below is a governance DRAFT; the WATER state is the real, binding one.

(define-module (playnet knowledge worlds bay-area)
  #:use-module (srfi srfi-1)
  #:use-module ((playnet vf formulas fragility) #:select (frag-within))
  #:use-module (playnet knowledge worlds bioregions)
  #:use-module (playnet vf schemas)
  ;; the derived record (generated by emit-derived.scm) — re-exported whole:
  ;; as a fragment this file leaked those names to whoever loaded it, and the
  ;; sweat tests read *bay-area-derived-warm-quarter-degc* through that leak
  #:use-module (playnet knowledge worlds bay-area-derived)
  #:re-export (*bay-area-derived-yields* *bay-area-derived-warm-quarter-degc* *bay-area-derived-ky-multipliers* *bay-area-derived-annual-mean-degc* *bay-area-derived-scenario-probs* *bay-area-derived-scenario-rain* *bay-area-derived-season*)
  #:export (ba-prob ba-mult *bay-area-crop-yields* *bay-area-scenarios/tail-robust*
            *bay-area-scenarios* *bay-area-stress-scenario* *bay-area*
            *bay-area-shed-spatials*))

(define (ba-prob k) (assoc-ref *bay-area-derived-scenario-probs* k))     ; probability from the record
(define (ba-mult k) (assoc-ref *bay-area-derived-ky-multipliers* k))     ; Ky multipliers from the record

;; Bay Area market-garden crops, US national baseline (kg/ha) [DATA].
(define *bay-area-crop-yields* *bay-area-derived-yields*)

;; Scenarios (shared assembler, bioregions.scm): probabilities + multipliers from the
;; Bay's record, + a p=0 megadrought TAIL (Taleb precaution — the multi-year droughts
;; California actually sees, defended without a forecast).
(define *bay-area-scenarios/tail-robust*
  (assemble-scenarios "bay-area"
    (list (list "normal"  (ba-prob "normal")  (ba-mult "normal")  "Normal Mediterranean winter (~mean recharge). Baseline yields.")
          (list "drought" (ba-prob "drought") (ba-mult "drought") "Dry winter (<mean−σ, ~171 mm). Reservoirs low; the dry summer bites every irrigated crop.")
          (list "flood"   (ba-prob "flood")   (ba-mult "flood")   "Wet winter / atmospheric river (>mean+σ). Ample water; some waterlogging."))
    (list '(("tomato" . 0.30) ("potato" . 0.28) ("bean" . 0.25) ("pea" . 0.25))
          "TAIL: multi-year megadrought beyond the record (the state's recurring dry decades). p=0; floor defended regardless.")))
(define *bay-area-scenarios*       (drop-right *bay-area-scenarios/tail-robust* 1))  ; bets on the record
(define *bay-area-stress-scenario* (last *bay-area-scenarios/tail-robust*))          ; the p=0 tail

;; The bioregion: an ecological agent at San Francisco Bay, its FUTURES (above) and its
;; LIMITS — here dominated by WATER (Aqueduct 0.97 "extremely high"), the binding
;; California constraint, plus the carbon-poor Mediterranean topsoil. parent "biosphere":
;; one commons, one containment tree, alongside Doon/Cascadia/Berlin.
(define *bay-area*
  (register-bioregion!
   (make-bioregion "bay-area" "San Francisco Bay Area" 37.77 -122.42 "biosphere"
     *bay-area-scenarios/tail-robust*                          ; FUTURES [DATA]
     ;; Water is a COMMONS, and here the record says so outright: "over-allocated"
     ;; IS the distributed-draw failure — many claims each defensible alone,
     ;; collectively past the envelope. That is the exact case playnet.typ
     ;; §"Shared budgets" gives the pooled budget for, so it is held over the
     ;; whole shed. Topsoil stays per-plot: one field's carbon is not the next's.
     (list (frag-within "bay-area" '("water") (list 80.0 120.0 0.15 65.0)
                        #:note "over-allocated, extremely stressed, POOLED; α=0.15 [DRAFT]")
           (cons "topsoil" (list 80.0 120.0 0.30 40.0))))))    ; SOC-mining envelope; carbon-poor CA cropland [DRAFT]

;; The containment tree for scopes in the shed: biosphere ⊃ bay-area ⊃ {SF, Oakland}.
;; SF and Oakland are places within the shed; communes placed there inherit its futures
;; AND limits by the walk. (The subscope communes are seeded live under earth.)
(define *bay-area-shed-spatials*
  (list (make-spatial-thing #:id "biosphere" #:lat 0.0 #:long 0.0)
        (bioregion-spatial *bay-area*)
        (make-spatial-thing #:id "san-francisco" #:name "San Francisco" #:lat 37.77 #:long -122.42
                            #:contained-in "bay-area")
        (make-spatial-thing #:id "oakland"       #:name "Oakland" #:lat 37.80 #:long -122.27
                            #:contained-in "bay-area")))
