;;; cascadia.scm — the Cascadia bioregion (Pacific NW) as a first-class ecological
;;; agent, paralleling worlds/doon-shed.scm. A SECOND real bioregion proves the whole stack
;;; is generic: same <bioregion> record, same pipeline, a different continent and a
;;; WINTER wet season. Its climate is its OWN — winter-wet marine, dry summers.
;;;
;;; Loaded after planner.scm (make-planning-scenario, make-bioregion, register-bioregion!).
;;; Provides *cascadia* (a <bioregion>) + its scenario sets.
;;;
;;; ── PROVENANCE (data/sources.md) ───────────────────────────────────────────────
;;; [DATA]  Climate — ERA5 via Open-Meteo, the Willamette Valley's OWN 1960–2023 record
;;;   (data/raw/cascadia): growing season AUTO-detected as the winter wet months
;;;   (Nov–Mar) — no agronomic input; mean 767 mm σ 188 mm; drought 0.14 / normal 0.66
;;;   / flood 0.20 (the ±1σ rule). Generated into worlds/cascadia-derived.scm (emit-derived.scm).
;;; [DERIVED] Multipliers — FAO Ky × the local winter rainfall (drought ≈0.64, the
;;;   Willamette rotation crops). Kept as the Ky baseline (no stage-physiology refinement
;;;   claimed, unlike Doon's rice) — honest to what we know.
;;; [DATA]  Yields — US national (OWID/FAOSTAT); PNW-specific is the W2 refinement.
;;; [DATA]  Fragility STATE — real, reproducible, any point:
;;;   · streamflow/water — WRI Aqueduct baseline stress 0.12 ("low") but seasonal
;;;     variability HIGH (dry summers) — the summer-low-flow signal salmon feel
;;;     (process-water.scm). · heat/frost — ERA5: 40.5 frost days/yr, only 3.7 hot days,
;;;     warming +1.05°C/60yr (fastest of our bioregions; process-temp.scm). · old-growth
;;;     forest — ESA WorldCover 10m: 98% tree cover in the Cascades (44.3,-122.0), the
;;;     conifer core the fragility watches; the Willamette valley is 19% (agri; process-forest.scm).
;;; [DRAFT] Fragility RANGES + the salmon/old-growth tips stay governance (to be
;;;   RATIFIED). All three STATE variables are now real data, key-free, reproducible.

(define-module (playnet knowledge worlds cascadia)
  #:use-module (srfi srfi-1)
  #:use-module ((playnet vf formulas fragility) #:select (frag-within))
  #:use-module (playnet knowledge worlds bioregions)
  #:use-module (playnet vf schemas)
  ;; the derived record (generated by emit-derived.scm) — re-exported whole:
  ;; as a fragment this file leaked those names to whoever loaded it, and the
  ;; sweat tests read *cascadia-derived-warm-quarter-degc* through that leak
  #:use-module (playnet knowledge worlds cascadia-derived)
  #:re-export (*cascadia-derived-yields* *cascadia-derived-ky-multipliers* *cascadia-derived-annual-mean-degc* *cascadia-derived-scenario-probs* *cascadia-derived-warm-quarter-degc* *cascadia-derived-scenario-rain* *cascadia-derived-season*)
  #:export (casc-prob casc-mult *cascadia-crop-yields*
            *cascadia-scenarios/tail-robust* *cascadia-scenarios*
            *cascadia-stress-scenario* *cascadia*))

(define (casc-prob k) (assoc-ref *cascadia-derived-scenario-probs* k))         ; probability from the record
(define (casc-mult k) (assoc-ref *cascadia-derived-ky-multipliers* k))         ; Ky multipliers from the record

;; Willamette Valley rotation crops, US national baseline (kg/ha) [DATA].
(define *cascadia-crop-yields* *cascadia-derived-yields*)

;; Scenarios (shared bioregion assembler, bioregions.scm): probabilities straight from
;; the record, multipliers the FAO-Ky baseline, + a p=0 megadrought/megafire TAIL (Taleb
;; precaution, NOT from the record — defended without a forecast).
(define *cascadia-scenarios/tail-robust*
  (assemble-scenarios "cascadia"
    (list (list "normal"  (casc-prob "normal")  (casc-mult "normal")  "Normal marine winter (~mean recharge). Baseline yields.")
          (list "drought" (casc-prob "drought") (casc-mult "drought") "Dry winter / snowpack shortfall (<mean−σ). Summer water short; all crops down.")
          (list "flood"   (casc-prob "flood")   (casc-mult "flood")   "Atmospheric-river / excess winter (>mean+σ). Ample water; mild waterlogging."))
    (list '(("wheat" . 0.20) ("potato" . 0.25) ("bean" . 0.20) ("pea" . 0.20))
          "TAIL: megadrought + megafire, beyond the instrumental record. p=0; floor defended regardless.")))
(define *cascadia-scenarios*       (drop-right *cascadia-scenarios/tail-robust* 1))  ; bets on the record
(define *cascadia-stress-scenario* (last *cascadia-scenarios/tail-robust*))          ; the p=0 tail

;; The bioregion: an ecological agent at the Willamette Valley, its FUTURES (above) and
;; its MULTITUDE of LIMITS — Cascadia's are the wild-salmon runs, the old-growth forest
;; (irreversible ⇒ low α), and summer streamflow. Its boundary (the map polygon) is
;; loaded by id from boundaries.json (bioregions.scm) — generic, no need to carry it here.
(define *cascadia*
  (register-bioregion!
   (make-bioregion "cascadia" "Cascadia" 45.0 -123.0 "biosphere"
     *cascadia-scenarios/tail-robust*                          ; FUTURES [DATA]
     ;; ── each limit at the SCALE it is actually held at ──────────────────────
     ;; All three are drawn on by every scope in the region, so all three are
     ;; POOLED (`within`): playnet.typ §"Shared budgets" — one envelope all
     ;; consumers share, which "catches the distributed-draw failure mode in
     ;; which many scopes each individually stay within their share, but
     ;; collectively exceed it". A per-spec rate would give each logger their
     ;; own forest and each irrigator their own river.
     ;;
     ;; What differs is the WINDOW, and old-growth is why the distinction is
     ;; not cosmetic. Streamflow and salmon RENEW: a season's flow returns next
     ;; season, a run that is not extirpated spawns again — so their limit is a
     ;; rate, a sustainable draw that resets. Old growth does not renew on any
     ;; horizon a plan can see; its own comment says irreversible, and a rate
     ;; would have refilled it every period. It is a HORIZON total: cut it and
     ;; it is cut.
     (list (frag-within "cascadia" '("streamflow") (list 80.0 120.0 0.20 50.0)
                        #:note "summer low-flow (salmon-bearing), pooled; renews each season [DRAFT]")
           (frag-within "cascadia" '("old-growth") (list 80.0 120.0 0.10 60.0)
                        #:window 'horizon
                        #:note "irreversible ⇒ α=0.10, and a TOTAL: it does not come back [DRAFT]")
           (frag-within "cascadia" '("salmon") (list 80.0 120.0 0.15 55.0)
                        #:note "wild runs, pooled; a renewable population ⇒ a rate [DRAFT]")))))
