;;; worlds/doon-shed.scm — the Doon Valley bioregion, ASSEMBLED as an ecological agent =
;;; a SpatialThing container (playnet.typ §bioregion) carrying a MULTITUDE of
;;; fragile specs. This is W2 ("calibrate ecological parameters to a real
;;; bioregion") made concrete: real, reproducibly-sourced state variables hung on
;;; ONE shed id, inherited by everything contained-in it via the containment spine
;;; (bioregions.scm + *frag-container*). Nothing here is bespoke machinery — it is
;;; DATA assembled onto the existing containment/fragility model.
;;;
;;; A bioregion is not one fragility. The Doon shed contains several, each its own
;;; drawable spec with its own barrier (the point of "any spec can carry
;;; fragilities"): the containment cascade rolls each contained spec's draw up to
;;; the shed, and each crop debits the ones it draws.
;;;
;;; Loaded after planner.scm (+ bioregions.scm, loaded by planner core) and
;;; worlds/doon-valley.scm (the scenario set). Provides ONE object — *doon-shed*, a
;;; <bioregion> — plus a derived containment tree for scopes placed in it.
;;;
;;; ── PROVENANCE (data/sources.md) ───────────────────────────────────────────────
;;; [DATA]  Climate scenarios — ERA5 via Open-Meteo, the shed's own 1960–2023 record
;;;         (worlds/doon-valley.scm): drought 0.14 / normal 0.67 / flood 0.19 + a p=0 tail.
;;; [DATA]  Fragility STATE variables — all real now (data/, reproducible, any point):
;;;         · topsoil — SoilGrids SOC 34.3 g/kg (0–30 cm), N 3.1, pH 5.9 (process-eco.scm).
;;;         · groundwater — WRI Aqueduct baseline water stress 1.72, "extremely high
;;;           (>80%)", seasonal variability extremely high (process-water.scm). Replaces
;;;           the old India-only CGWB gap with a GLOBAL source.
;;;         · heat — ERA5: 24.6 days/yr >35°C, warming +0.53°C/60yr (process-temp.scm).
;;; [DRAFT] Fragility RANGES [lo,hi], precaution α, weight w — the STATE is data, but the
;;;         tip ranges remain governance choices to be RATIFIED at UC level, transcribed
;;;         like eco-catalogue.scm's planetary boundaries, NOT engineering constants.

;; The whole bioregion in one declaration: where it is, the FUTURES it faces, and the
;; MULTITUDE of LIMITS it carries. Each fragility is a fragile spec the shed contains
;; ("any resource-spec can carry a fragility"); a crop that irrigates draws
;; `groundwater`, one that tills draws `topsoil`, one doing both is pulled by both.
;; Registering it makes a scope placed contained-in the shed inherit ALL of this.
(define-module (playnet knowledge worlds doon-shed)
  #:use-module (srfi srfi-1)
  #:use-module ((playnet vf formulas fragility) #:select (frag-within))
  #:use-module (playnet knowledge worlds bioregions)
  #:use-module (playnet vf schemas)
  #:use-module (playnet knowledge worlds doon-valley)
  ;; the derived record (generated by emit-derived.scm) — re-exported whole:
  ;; as a fragment this file leaked those names to whoever loaded it, and the
  ;; sweat tests read *doon-derived-warm-quarter-degc* through that leak
  #:use-module (playnet knowledge worlds doon-derived)
  #:re-export (*doon-derived-yields* *doon-derived-warm-quarter-degc* *doon-derived-scenario-probs* *doon-derived-annual-mean-degc* *doon-derived-scenario-rain* *doon-derived-season* *doon-derived-ky-multipliers*)
  #:export (*doon-shed* *doon-shed-spatials*))

(define *doon-shed*
  (register-bioregion!
   (make-bioregion #:id "doon-shed"
                   #:name "Doon Valley watershed"
                   #:lat 30.32
                   #:lon 78.03
                   #:parent "biosphere"
                   #:scenarios *doon-valley-scenarios/tail-robust*
                   #:fragilities (list (frag-within "doon-shed" '("groundwater") (list 80.0 120.0 0.2 50.0)
                        #:note "recharge envelope, POOLED across the shed; α=0.2 [DRAFT]")
           (cons "topsoil" (list 80.0 120.0 0.3 40.0))))))  ; SOC-mining envelope, per plot; α=0.3, state 34.3 g/kg [DATA]

;; The containment tree for a scope in the shed: biosphere ⊃ shed ⊃ farm. The shed's
;; own node comes straight from the record; place real plots contained-in "doon-shed".
(define *doon-shed-spatials*
  (list (make-spatial-thing #:id "biosphere" #:lat 0.0 #:long 0.0)
        (bioregion-spatial *doon-shed*)
        (make-spatial-thing #:id "doon-farm" #:name "Navdanya-style farm" #:lat 30.35 #:long 78.06
                            #:contained-in "doon-shed")))
