;;; berlin.scm — the Berlin/Brandenburg bioregion as a first-class ecological agent,
;;; the THIRD real shed (after worlds/doon-shed.scm and cascadia.scm). A third bioregion on a
;;; third continent, with a CONTINENTAL summer-wet climate and — the point of this one —
;;; a real DROUGHT signal: Brandenburg is one of Europe's driest, sandiest, fastest-
;;; warming agricultural regions, and the data shows it. Nothing here is new machinery;
;;; it is DATA assembled onto the <bioregion> container (bioregions.scm), inherited by
;;; any scope placed contained-in it via the same containment walk doon and cascadia use.
;;;
;;; Loaded after planner.scm (make-planning-scenario, make-bioregion, register-bioregion!,
;;; assemble-scenarios). Provides *berlin* (a <bioregion>) + its scenario/yield sets +
;;; *berlin-shed-spatials* (biosphere ⊃ shed ⊃ farm) for a scope placed in it.
;;;
;;; ── PROVENANCE (data/sources.md) ───────────────────────────────────────────────
;;; [DATA]  Climate — ERA5 via Open-Meteo, Berlin's OWN 1960–2023 record (data/raw/berlin):
;;;   growing season AUTO-detected (May–Aug); normal-season rain only ~302 mm (drought
;;;   198 / flood 413) — DRY. drought 0.19 / normal 0.64 / flood 0.17 (the ±1σ rule),
;;;   a HIGHER drought frequency than Doon or Cascadia (0.14). Generated into
;;;   worlds/berlin-derived.scm (emit-derived.scm). Warming +2.14 °C over the record (process-
;;;   temp.scm) — the fastest of our three sheds; a driver of the precautionary tail.
;;; [DERIVED] Multipliers — FAO Ky × the local rainfall: drought hits maize hardest
;;;   (0.57) and the small grains least (wheat 0.64, barley 0.66) — the fragility spread
;;;   the robust plan hedges across. Ky baseline (no stage-physiology refinement claimed).
;;; [DATA]  Yields — German national (OWID/FAOSTAT): the high-input temperate baseline
;;;   (wheat 7.4, barley 6.7, maize 9.6, potato 43.1 t/ha). Brandenburg-specific is the
;;;   W2 refinement (its sandy soils yield below the national mean — honest gap).
;;; [DATA]  Fragility STATE — real, reproducible, this point:
;;;   · groundwater/water — WRI Aqueduct baseline water stress 0.48 ("High", 40–80%),
;;;     overall risk "medium-to-high" (process-water.scm): the summer-water signal the
;;;     Spree/Havel sands feel. · topsoil — SoilGrids: SOC only 23.5 g/kg, N 3.4, pH 6.4
;;;     (process-eco.scm) — carbon-POOR sandy soil (cf. Doon 34.3), so the SOC-mining
;;;     envelope binds sooner. · heat/frost — ERA5: 77.6 frost days/yr, 0.3 hot days,
;;;     warming +2.14 °C/60 yr (process-temp.scm).
;;; [DRAFT] Fragility RANGES [lo,hi], precaution α, weight w stay governance (to be
;;;   RATIFIED at UC level), transcribed like the eco-catalogue's planetary boundaries.

(define-module (playnet knowledge worlds berlin)
  #:use-module (srfi srfi-1)
  #:use-module ((playnet vf formulas fragility) #:select (frag-within))
  #:use-module (playnet knowledge worlds bioregions)
  #:use-module (playnet vf schemas)
  ;; the derived record (generated by emit-derived.scm) — re-exported whole:
  ;; as a fragment this file leaked those names to whoever loaded it, and the
  ;; sweat tests read *berlin-derived-warm-quarter-degc* through that leak
  #:use-module (playnet knowledge worlds berlin-derived)
  #:re-export (*berlin-derived-scenario-probs* *berlin-derived-warm-quarter-degc* *berlin-derived-annual-mean-degc* *berlin-derived-season* *berlin-derived-yields* *berlin-derived-ky-multipliers* *berlin-derived-scenario-rain*)
  #:export (berl-prob berl-mult *berlin-crop-yields* *berlin-scenarios/tail-robust*
            *berlin-scenarios* *berlin-stress-scenario* *berlin*
            *berlin-shed-spatials*))

(define (berl-prob k) (assoc-ref *berlin-derived-scenario-probs* k))     ; probability from the record
(define (berl-mult k) (assoc-ref *berlin-derived-ky-multipliers* k))     ; Ky multipliers from the record

;; Brandenburg field crops, German national baseline (kg/ha) [DATA]. Potato is the
;; region's #1 food crop by tonnage; the small grains + maize are the scenario-sensitive
;; staples the farm plans (brandenburg-farm.scm), potato/rye the wider ledger.
(define *berlin-crop-yields* *berlin-derived-yields*)

;; Scenarios (shared assembler, bioregions.scm): probabilities + multipliers straight
;; from Berlin's record, + a p=0 megadrought/heat TAIL (Taleb precaution, NOT forecast —
;; defended without a probability). The warming trend is why the tail is a heat-drought.
(define *berlin-scenarios/tail-robust*
  (assemble-scenarios "berlin"
    (list (list "normal"  (berl-prob "normal")  (berl-mult "normal")  "Normal continental summer (~mean rain). Baseline yields.")
          (list "drought" (berl-prob "drought") (berl-mult "drought") "Dry summer (<mean−σ, ~198 mm). Sandy soils drain fast; maize hit hardest.")
          (list "flood"   (berl-prob "flood")   (berl-mult "flood")   "Wet summer (>mean+σ). Ample water; mild waterlogging on heavy patches."))
    (list '(("wheat" . 0.22) ("barley" . 0.22) ("maize" . 0.30) ("potato" . 0.28))
          "TAIL: back-to-back heat-drought summers beyond the record (the +2.14°C trend's edge). p=0; floor defended regardless.")))
(define *berlin-scenarios*       (drop-right *berlin-scenarios/tail-robust* 1))  ; bets on the record
(define *berlin-stress-scenario* (last *berlin-scenarios/tail-robust*))          ; the p=0 tail

;; The bioregion: an ecological agent at Berlin/Brandenburg, its FUTURES (above) and its
;; MULTITUDE of LIMITS — here the sandy region's water stress and its carbon-poor topsoil.
;; parent "biosphere": it hangs under the same shared root Doon and Cascadia do — one
;; commons, one containment tree. Its boundary (map polygon) loads by id if declared.
(define *berlin*
  (register-bioregion!
   (make-bioregion "berlin" "Berlin/Brandenburg" 52.52 13.40 "biosphere"
     *berlin-scenarios/tail-robust*                           ; FUTURES [DATA]
     ;; Groundwater is a COMMONS — one body of water under the whole region, and
     ;; every scope above it draws the same body, so it is pooled over the shed
     ;; (playnet.typ §"Shared budgets"). Topsoil is not: the carbon under one
     ;; field is not the carbon under the next, so it stays a per-plot RATE.
     ;; Pooling it would make a farm that tends its soil pay for one that mines
     ;; theirs; leaving groundwater per-plot would give every well its own aquifer.
     (list (frag-within "berlin" '("groundwater") (list 80.0 120.0 0.20 55.0)
                        #:note "water-stress envelope (Aqueduct 0.48 High), POOLED; α=0.20 [DRAFT]")
           (cons "topsoil"     (list 80.0 120.0 0.30 45.0)))))); SOC-mining envelope; carbon-poor (23.5 g/kg) ⇒ binds sooner [DATA/DRAFT]

;; The containment tree for a scope in the shed: biosphere ⊃ shed ⊃ farm. Place real
;; plots contained-in "berlin"; they inherit the shed's futures AND limits by the walk.
(define *berlin-shed-spatials*
  (list (make-spatial-thing #:id "biosphere" #:lat 0.0 #:long 0.0)
        (bioregion-spatial *berlin*)
        (make-spatial-thing #:id "brandenburg-farm" #:name "Brandenburg market-garden farm"
                            #:lat 52.48 #:long 13.40 #:contained-in "berlin")))
