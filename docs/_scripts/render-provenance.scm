#!/usr/bin/env guile
!#
;;; render-provenance.scm — one graph, from the same facts.
;;;
;;; Emits docs/planning/provenance-graph.md: a Mermaid flowchart of the whole
;;; prose→code→number graph. Claims that are still only argued are flagged. Renders
;;; in Obsidian, GitHub, and the Radicle web view — humans and agents read the same
;;; picture the relations query.
;;;
;;; Usage:  guile docs/_scripts/render-provenance.scm   (make render-provenance)

(use-modules (ice-9 textual-ports) (srfi srfi-1))
(define %root
  (canonicalize-path (string-append (dirname (current-filename)) "/../..")))
(add-to-load-path (string-append %root "/module"))
(use-modules (playnet lang provenance))

(define out "docs/planning/provenance-graph.md")

;;; ── node bookkeeping ─────────────────────────────────────────────────────────

(define (facts-of tag) (filter (lambda (f) (eq? (car f) tag)) *provenance-facts*))
(define (nid sym) (string-map (lambda (c) (if (or (char-alphabetic? c) (char-numeric? c)) c #\_))
                              (symbol->string sym)))
(define ung (ungrounded-claims))

(define (node sym kind)
  (let ((id (nid sym)) (lbl (symbol->string sym)))
    (case kind
      ((claim) (format #f "  ~a[\"~a\"]:::~a" id lbl (if (memq sym ung) "ungrounded" "claim")))
      ((ref)   (format #f "  ~a[[\"~a\"]]:::ref" id lbl))
      ((pid)   (format #f "  ~a([\"~a\"]):::pid" id lbl)))))

;; collect distinct nodes by kind
(define claims (delete-duplicates (all-claims)))
(define refs   (delete-duplicates (all-refs)))
(define pids   (delete-duplicates (realized-ids)))

;;; ── edges ─────────────────────────────────────────────────────────────────────

(define grounds-edges
  (map (lambda (f) (format #f "  ~a --> ~a" (nid (cadr f)) (nid (caddr f)))) (facts-of 'grounds)))
(define builds-edges
  (map (lambda (f) (format #f "  ~a -. builds .-> ~a" (nid (cadr f)) (nid (caddr f)))) (facts-of 'builds)))
(define realizes-edges
  (map (lambda (f) (format #f "  ~a -. realizes .-> ~a" (nid (cadr f)) (nid (caddr f)))) (facts-of 'realizes)))

;;; ── assemble ──────────────────────────────────────────────────────────────────

(define lines
  (append
   (list "# Provenance graph"
         ""
         "*Generated by `docs/_scripts/render-provenance.scm` — do not edit. Prose → knowledge"
         "ref → parent ref, dashed to the planner id a claim realizes. Amber = still only argued.*"
         ""
         "```mermaid"
         "flowchart LR")
   (map (lambda (c) (node c 'claim)) claims)
   (map (lambda (r) (node r 'ref)) refs)
   (map (lambda (p) (node p 'pid)) pids)
   (list "")
   grounds-edges builds-edges realizes-edges
   (list ""
         "  classDef claim fill:#1f6feb22,stroke:#1f6feb,color:#c9d1d9;"
         "  classDef ungrounded fill:#f0883e22,stroke:#f0883e,stroke-dasharray:4,color:#c9d1d9;"
         "  classDef ref fill:#2ea04322,stroke:#2ea043,color:#c9d1d9;"
         "  classDef pid fill:#8957e522,stroke:#8957e5,color:#c9d1d9;"
         "```"
         ""
         (format #f "_~a claims (~a still only argued), ~a refs, ~a planner ids._"
                 (length claims) (length ung) (length refs) (length pids)))))

(call-with-output-file (string-append %root "/" out)
  (lambda (p) (display (string-join lines "\n") p) (newline p)))
(format #t "wrote ~a (~a claims, ~a refs, ~a ids)~%" out (length claims) (length refs) (length pids))
