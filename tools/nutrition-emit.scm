#!/usr/bin/env -S guile -L module
!#
;;; tools/nutrition-emit.scm — ui/app/nutrition-catalogue.ts from the catalogue
;;;
;;;   nutrition-emit.scm [out]      the browser's copy of every subsistence table
;;;
;;; The subsistence catalogue (module/playnet/planner/knowledge/
;;; catalogues/subsistence.scm) states each nutrient's band once — the species
;;; base, the sex split, the adult conditions, the child and adolescent bands,
;;; the climate and diet shifts. The browser folds the same layers over the
;;; same numbers (ui/app/nutrition.ts), and this emit is how it gets them: the
;;; catalogue's tables, as TypeScript. `make check-nutrition-fresh` regenerates
;;; and diffs the committed copy, the gate seam-wire.ts already has.
;;;
;;; The one translation is the unit: the catalogue writes "ug", the page "µg".

(use-modules ((playnet utils ts-emit) #:select ((ts-num . num) (ts-str . str))))
(use-modules (playnet planner knowledge catalogues subsistence)
             (ice-9 match) (ice-9 format) (srfi srfi-1))

(define T (subsistence-catalogue-tables))
(define (table k) (assoc-ref T k))

;; ── writing values ───────────────────────────────────────────────────────
(define (unit u) (str (if (equal? u "ug") "µg" u)))
;; a shift row ("spec" #:rda x #:ul y #:w z) ⇒ spec: { rda: x, ul: y, w: z }
(define (scale-fields kws)
  (let loop ((kws kws) (out '()))
    (match kws
      (() (string-join (reverse out) ", "))
      (((? keyword? k) v . rest)
       (loop rest (cons (format #f "~a: ~a" (keyword->symbol k) (num v)) out))))))
(define (shift-rows rows)
  (string-join (map (lambda (r) (format #f "~a: { ~a }" (str (car r)) (scale-fields (cdr r)))) rows) ", "))
(define (by-key rows)   ; (("key" row …) …) ⇒ "key": { rows }
  (string-concatenate
   (map (lambda (e) (format #f "  ~a: { ~a },\n" (str (car e)) (shift-rows (cdr e)))) rows)))

;; ── the bands: one table per (band, sex) from the two nutrient-major tables ──
(define (band-table i sex)
  (string-join
   (map (lambda (r)
          (let* ((spec (car r))
                 (ulr (assoc spec (table 'band-ul)))
                 (ul (and ulr (band-cell ulr i sex))))
            (format #f "~a: { rda: ~a~a }" (str spec) (num (band-cell r i sex))
                    (if ul (format #f ", ul: ~a" (num ul)) ""))))
        (table 'band-rda))
   ", "))

(define (catalogue-ts)
  (string-append
   "// ui/app/nutrition-catalogue.ts — GENERATED by tools/nutrition-emit.scm from\n"
   "// module/playnet/planner/knowledge/catalogues/subsistence.scm. Do not edit;\n"
   "// `make nutrition-emit`.\n"
   "//\n"
   "// Every table the nutrition layers fold over, as the catalogue states it:\n"
   "// the species base (L0), the sex split and the adult conditions and the\n"
   "// child and adolescent bands (L2), the climate shifts (L1), the diet\n"
   "// shifts (L2b) and the follow rule. nutrition.ts holds the layers; the numbers live here, and\n"
   "// here only because the catalogue wrote them.\n"
   "\n"
   "import type { Profile, Sex, NutrientScale, BandTable } from \"./nutrition.js\";\n"
   "\n"
   "/** L0 · the species floor: the sex-neutral adult base every layer folds over. */\n"
   "export const SPECIES_BASE: Profile = {\n"
   (string-concatenate
    (map (lambda (n)
           (format #f "  ~a: { group: ~a, unit: ~a, rda: ~a, ul: ~a, w: ~a },\n"
                   (str (sub-spec n)) (str (sub-group n)) (unit (sub-unit n))
                   (num (sub-rda n)) (if (sub-ul n) (num (sub-ul n)) "null") (num (sub-w n))))
         (table 'species-base)))
   "};\n"
   "\n"
   "/** L2 · the adult sex split, as ratios on the base. */\n"
   "export const SEX_SHIFTS: Record<Sex, Record<string, NutrientScale>> = {\n"
   (by-key (table 'sex-shifts))
   "};\n"
   "\n"
   "/** The age from which the elder table applies. */\n"
   "export const ELDER_AGE = " (num (table 'elder-age)) ";\n"
   "\n"
   "/** L2 · the adult conditions, per sex, as ratios on the sex-shifted base. */\n"
   "export const ADULT_SHIFTS: Record<\"elder\" | \"pregnant\" | \"lactating\", Record<Sex, Record<string, NutrientScale>>> = {\n"
   (string-concatenate
    (map (lambda (c)
           (string-append "  " (car c) ": {\n"
                          (string-concatenate
                           (map (lambda (e) (format #f "    ~a: { ~a },\n" (car e) (shift-rows (cdr e)))) (cdr c)))
                          "  },\n"))
         (table 'adult-shifts)))
   "};\n"
   "\n"
   "/** L2 · childhood and adolescence: each band its own DRI table, set rather than scaled. */\n"
   "export const BANDS: { maxAge: number; F: BandTable; M: BandTable }[] = [\n"
   (string-concatenate
    (map (lambda (max-age i)
           (format #f "  { maxAge: ~a,\n    F: { ~a },\n    M: { ~a } },\n"
                   (num max-age) (band-table i "F") (band-table i "M")))
         (table 'band-max-age) (iota (length (table 'band-max-age)))))
   "];\n"
   "\n"
   "/** L1 · climate: shifts on the species floor by region. */\n"
   "export const GEO_SHIFTS: Record<string, Record<string, NutrientScale>> = {\n"
   (by-key (table 'geo-shifts))
   "};\n"
   "\n"
   "/** L2b · diet: what a person refuses raises what the rest must carry. */\n"
   "export const DIET_SHIFTS: Record<string, Record<string, NutrientScale>> = {\n"
   (by-key (table 'diet-shifts))
   "};\n"
   "\n"
   "/** A nutrient that FOLLOWS another, run last: [spec, source, ratio] — lysine is 51 mg per g of the protein floor. */\n"
   "export const FOLLOWS: [string, string, number][] = [\n"
   (string-concatenate
    (map (lambda (r) (format #f "  [~a, ~a, ~a],\n" (str (car r)) (str (cadr r)) (num (caddr r)))) (table 'follows)))
   "];\n"
   "\n"
   "/** L2c · the DRI reference body per band (kg, m); maxAge null is the adult row. */\n"
   "export const REFERENCE_BODY: { maxAge: number | null; F: { kg: number; m: number }; M: { kg: number; m: number } }[] = [\n"
   (string-concatenate
    (map (lambda (r) (format #f "  { maxAge: ~a, F: { kg: ~a, m: ~a }, M: { kg: ~a, m: ~a } },\n"
                             (if (car r) (num (car r)) "null") (num (list-ref r 1)) (num (list-ref r 2)) (num (list-ref r 3)) (num (list-ref r 4))))
         (table 'reference-body)))
   "];\n"
   "\n"
   "/** L2c · the estimated energy requirement: [sex, minAge, intercept, ageTerm, pa (low active — the floor), kgTerm, mTerm, growth, paTop (very active — the energy ceiling)]. */\n"
   "export const EER_ROWS: [Sex, number, number, number, number, number, number, number, number][] = [\n"
   (string-concatenate
    (map (lambda (r) (format #f "  [~a, ~a],\n" (str (car r)) (string-join (map num (cdr r)) ", "))) (table 'eer-rows)))
   "];\n"
   "\n"
   "/** L3 · how hard an hour is: the weight on committed hours per class; moderate is the unweighted hour. */\n"
   "export const WORK_INTENSITY: Record<string, number> = {\n"
   (string-concatenate (map (lambda (e) (format #f "  ~a: ~a,\n" (str (car e)) (num (cdr e)))) (table 'work-intensity)))
   "};\n"
   "\n"
   "/** L1 · altitude: [metres, rows], the highest threshold at or below the elevation wins. */\n"
   "export const ALTITUDE_SHIFTS: [number, Record<string, NutrientScale>][] = [\n"
   (string-concatenate (map (lambda (r) (format #f "  [~a, { ~a }],\n" (num (car r)) (shift-rows (cdr r)))) (table 'altitude-shifts)))
   "];\n"
   "\n"
   "/** L1 · winter sun: beyond this latitude the dark half-year makes no vitamin D in the skin. */\n"
   "export const WINTER_SUN_LAT = " (num (table 'winter-sun-lat)) ";\n"
   "export const WINTER_SUN_SHIFT: Record<string, NutrientScale> = { " (shift-rows (table 'winter-sun-shift)) " };\n"
   "\n"
   "/** L5 · the named conditions a person may state about their own body, and the rows each carries. */\n"
   "export const SELF_CONDITIONS: Record<string, { label: string; rows: Record<string, NutrientScale> }> = {\n"
   (string-concatenate
    (map (lambda (c) (format #f "  ~a: { label: ~a, rows: { ~a } },\n" (str (car c)) (str (cadr c)) (shift-rows (cddr c))))
         (table 'self-conditions)))
   "};\n"
   "\n"
   "/** The latitudes that place a fix in a climate region: within HOT of the equator is hot, from COLD cold, from HIGH high latitude, the rest temperate. */\n"
   "export const REGION_LATITUDES = { hot: " (num (car (table 'region-latitudes))) ", cold: " (num (cadr (table 'region-latitudes))) ", high: " (num (caddr (table 'region-latitudes))) " };\n"
   "\n"
   "/** The working temperature a region implies when no shed states one. */\n"
   "export const REGION_WORKING_DEGC: Record<string, number> = {\n"
   (string-concatenate
    (map (lambda (e) (format #f "  ~a: ~a,\n" (str (car e)) (num (cdr e)))) (table 'region-working-degc)))
   "};\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: nutrition-emit.scm [out]\n") (exit 2)))
