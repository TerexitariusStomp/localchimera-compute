#!/usr/bin/env -S guile -L module
!#
;;; tools/rest-emit.scm — ui/app/rest-catalogue.ts from the rest catalogue
;;;
;;;   rest-emit.scm [out]      the browser's copy of the SNIRT tables
;;;
;;; The rest catalogue (module/playnet/knowledge/catalogues/rest.scm)
;;; states the time floor of the right to rest: sleep by age band, the day's
;;; meals and washing, and the labour increment. The browser folds the person
;;; layer over the same numbers (ui/app/rest.ts), and this emit is how it gets
;;; them — housing-emit's twin. `make check-rest-fresh` regenerates and diffs
;;; the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-num . num) (ts-str . str))))
(use-modules (playnet knowledge catalogues rest)
             (ice-9 match) (ice-9 format) (srfi srfi-1))

(define (catalogue-ts)
  (string-append
   "// ui/app/rest-catalogue.ts — GENERATED by tools/rest-emit.scm from\n"
   "// module/playnet/knowledge/catalogues/rest.scm. Do not edit;\n"
   "// `make rest-emit`.\n"
   "//\n"
   "// The time floor of the right to rest (SNIRT): sleep by age band, the day's\n"
   "// meals and washing, and the labour increment. rest.ts holds the person\n"
   "// layer; the numbers live here, and here only because the catalogue wrote them.\n"
   "\n"
   "/** (max age, hours of sleep a day): the first band whose max age exceeds the person's. */\n"
   "export const SLEEP_BANDS: [number, number][] = [\n"
   (string-concatenate
    (map (lambda (b) (format #f "  [~a, ~a],\n" (num (car b)) (num (cadr b)))) *sleep-bands*))
   "];\n"
   "\n"
   "/** Meals, washing and dressing a day. */\n"
   "export const PERSONAL_HOURS = " (num *personal-hours*) ";\n"
   "\n"
   "/** Rest owed per hour of labour, times the effort the work states. */\n"
   "export const REST_LABOUR_INCREMENT = " (num *rest-labour-increment*) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: rest-emit.scm [out]\n") (exit 2)))
