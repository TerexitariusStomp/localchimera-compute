#!/usr/bin/env -S guile -L module
!#
;;; tools/rel-emit.scm — ui/app/rel-catalogue.ts from the relationship kinds
;;;
;;;   rel-emit.scm [out]      the browser's copy of the kinds a relationship is named by
;;;
;;; A relationship's kind is written on both sides of the wire: the page tags
;;; a contact and names the kind a vouch carries (ui/app/book.ts,
;;; ui/app/tabs/contacts.ts), and the gateway reads it as a lens, a group and a
;;; relationship credential's type (social/lens.scm, matching/filter-rule.scm,
;;; doors/governance.scm). (playnet social relationship-kinds) states the
;;; kinds once; this emit is how the page gets them. `make check-rel-fresh`
;;; regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-str . str)))
             (playnet social relationship-kinds)
             (ice-9 match) (srfi srfi-1))

(define (kind-ts k)
  (string-append "  { id: " (str (kind-id k)) ", plural: " (str (kind-plural k))
                 ", colour: " (str (kind-colour k)) " },\n"))

(define (catalogue-ts)
  (string-append
   "// ui/app/rel-catalogue.ts — GENERATED by tools/rel-emit.scm from\n"
   "// module/playnet/social/relationship-kinds.scm. Do not edit; `make rel-emit`.\n"
   "//\n"
   "// The kinds a relationship is named by: the tag a contact carries, the type a\n"
   "// vouch states, the lens and the group a rule names. The set is open — a\n"
   "// person's own word is a kind of its own — and these are the ones offered.\n"
   "\n"
   "export interface RelKind { readonly id: string; readonly plural: string; readonly colour: string; }\n"
   "\n"
   "/** The kinds the app offers, in the order it offers them. */\n"
   "export const REL_KINDS: readonly RelKind[] = [\n"
   (string-concatenate (map kind-ts %relationship-kinds))
   "];\n"
   "/** The kind a contact has before anyone says more. */\n"
   "export const DEFAULT_REL = " (str %default-rel) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: rel-emit.scm [out]\n") (exit 2)))
