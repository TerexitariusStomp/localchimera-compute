#!/usr/bin/env -S guile -L module
!#
;;; tools/units-emit.scm — ui/app/units-catalogue.ts from the unit module
;;;
;;;   units-emit.scm [out]      the browser's copy of the units the planner writes and reads
;;;
;;; A count and an effort are written in one unit each (utils/units.scm:
;;; %count-unit, %effort-unit), a row carries a placeholder until its door
;;; states the specification's own, and a duration is stated in a unit of time
;;; the tables convert. The page writes and reads the same units — a blank slot's
;;; unit, "is this counted in itself", "is this a pool of time" — so it reads
;;; this generated copy and spells none of them by hand. `make
;;; check-units-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-str . str)))
             ((playnet utils units) #:select (%count-unit %effort-unit %placeholder-unit %time-unit-names))
             (ice-9 match))

(define (catalogue-ts)
  (string-append
   "// ui/app/units-catalogue.ts — GENERATED by tools/units-emit.scm from\n"
   "// module/playnet/utils/units.scm. Do not edit; `make units-emit`.\n"
   "//\n"
   "// The units the planner writes of its own accord and the questions it asks of\n"
   "// one, so the page and the planner read a unit alike.\n"
   "\n"
   "/** The unit a count of a thing is written in. */\n"
   "export const COUNT_UNIT = " (str %count-unit) ";\n"
   "/** The unit an effort in time is written in. */\n"
   "export const EFFORT_UNIT = " (str %effort-unit) ";\n"
   "/** The unit a row carries until its door states the specification's own. */\n"
   "export const PLACEHOLDER_UNIT = " (str %placeholder-unit) ";\n"
   "/** Every spelling of a unit of time the unit tables convert. */\n"
   "export const TIME_UNITS: readonly string[] = [" (string-join (map str %time-unit-names) ", ") "];\n"
   "\n"
   "/** A thing counted in itself: no unit stated, the count unit, or the placeholder. */\n"
   "export const isCountUnit = (unit: string | null | undefined): boolean =>\n"
   "  !unit || unit === COUNT_UNIT || unit === PLACEHOLDER_UNIT;\n"
   "/** A unit that measures time — an effort, a duration, a pool of hours. */\n"
   "export const isTimeUnit = (unit: string | null | undefined): boolean =>\n"
   "  !!unit && TIME_UNITS.includes(unit);\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: units-emit.scm [out]\n") (exit 2)))
