#!/usr/bin/env -S guile -L module
!#
;;; tools/demo-emit.scm — ui/app/demo/recording.ts, the offline demo as a recording
;;;
;;;   demo-emit.scm [out]   what a seat in the demo neighbourhood is answered
;;;
;;; Where no gateway stands the page shows a demo. That demo is this recording:
;;; the demo neighbourhood (planner/knowledge/worlds/demo-neighbourhood.scm) stands in a
;;; real scope, its acts are played through the real doors, and what the planner
;;; and governance then answer the demo's person is written down in the shapes
;;; the page reads them in (the wire tables of (playnet wire replies) and the row
;;; tables each door's reply is finished through — the same the gateway answers through). So the page holds no demo
;;; figures of its own: it plays what a gateway would have sent.
;;;
;;; The recording is made on one fixed day with the clock stood on it, where ids
;;; are counted in order, so it reads the same on every run; the page moves
;;; its dates to the day it is opened on (ui/app/demo/seat.ts).
;;; `make check-demo-fresh` regenerates and diffs the committed copy.

(use-modules (playnet knowledge worlds demo-neighbourhood)
             (playnet doors demo-stage)
             (playnet knowledge dsl world)
             ((playnet vf schemas) #:select (economic-resource-id resource-specification-id agent-id agent-type))
             (playnet wire rows)
             (playnet wire replies)
             ((playnet utils clock) #:select (stand-clock! civil->epoch))
             ((playnet gateway allotment) #:select (allotment-week allotment-doc allotment-reply))
             (json)
             (ice-9 match) (srfi srfi-1))

;; the day the recording is made on, at noon: a Monday
(define %day "2026-01-05")
(define %today (civil->epoch (string-append %day "T12:00:00Z")))

(define (answer reply)
  "What a door answered, without its ok; a refusal stops the recording."
  (match reply
    (('ok . v) v)
    (_ (error "demo-emit: a door refused" reply))))

(define (recording)
  (stand-clock! %today)
  (let* ((stage (stage-demo %today))
         (call  (assq-ref stage 'planner))
         (gov   (assq-ref stage 'governance))
         (snap  (call 'scope-snapshot %demo-scope #f %demo-you))
         (stocks (map economic-resource-id (world-resources demo-world)))
         (specs  (map resource-specification-id (world-specs demo-world)))
         (by (lambda (ids ask) (map (lambda (id) (cons id (ask id))) ids))))
    (for-each (lambda (r) (answer r)) (assq-ref stage 'replies))
    `(("day" . ,%day)
      ("face" . ,(demo-face))
      ("snapshot" . ,snap)
      ;; everyone's needs and offers, each person's read through their own slots
      ;; door: a need under who asks, an offer under who makes it
      ("pool" . ,(let* ((people (map agent-id (filter (lambda (a) (eq? 'person (agent-type a)))
                                                      (world-agents demo-world))))
                        (of (lambda (side label)
                              (append-map
                               (lambda (who)
                                 (map (lambda (s) (cons (cons label who) s))
                                      (->list (assoc-ref (answer (call 'my-slots %demo-scope who)) side))))
                               people))))
                   `(("needs" . ,(list->vector (of "needs" "who"))) ("means" . ,(list->vector (of "means" "owner"))))))
      ("replies"
       . (("countSchedule" . ,(answer (call 'count-schedule %demo-scope)))
          ("countHistory"
           . ,(by stocks (lambda (id) (answer (call 'count-history %demo-scope %demo-you id)))))
          ("scopeReadings"
           . ,(by specs (lambda (id) (answer (call 'scope-readings %demo-scope id)))))
          ("readingsBetween"
           . ,(by specs (lambda (id) (answer (call 'readings-between %demo-scope id "" "")))))
          ("contests" . ,(answer (gov 'contests %demo-you %demo-scope)))
          ;; what people ask for and offer: the person's own, the scope's fold, and
          ;; the pool as the map reads it
          ("mySlots" . ,(answer (call 'my-slots %demo-scope %demo-you)))
          ("ourSlots" . ,(answer (call 'our-slots %demo-scope %demo-scope %demo-you)))
          ("slotsAt" . ,(answer (call 'slots-at %demo-scope)))
          ;; the week's photo reads, four of them spent, where a picture can be read
          ("allotment" . ,(reply->wire 'allotment
                                       (let ((week (allotment-week %today)))
                                         (allotment-reply (allotment-doc week 4) week #t))))
          ("myClaims" . ,(answer (call 'my-claims %demo-scope %demo-you))))))))

(define (recording-ts)
  (string-append
   "// GENERATED by tools/demo-emit.scm from module/playnet/knowledge/worlds/demo-neighbourhood.scm — do not edit.\n"
   "// Regenerate: make demo-emit\n"
   "//\n"
   "// The offline demo, as a recording: what the planner and governance answer the\n"
   "// demo's person once the neighbourhood stands in a real scope and its acts are\n"
   "// played. demo/seat.ts plays it through the doors live data enters by.\n\n"
   "export const RECORDING = "
   (scm->json-string (recording) #:pretty #t)
   ";\n"))

(match (cdr (command-line))
  ((out) (let ((ts (recording-ts))) (call-with-output-file out (lambda (p) (display ts p)))))
  (() (display (recording-ts)))
  (_ (display "usage: demo-emit.scm [out]\n") (exit 2)))
