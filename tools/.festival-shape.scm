;; scratch harness: the festival seed in its located shape, with the live store's extras
;; EXTRAS=1|2  PERIODS=n  SKILLS=0  REPRO=0  WANT_SPEC=  WANT_PLACE=
(use-modules (playnet planner knowledge recipes berlin-commune-seed) (playnet planner knowledge recipes berlin-festival-seed) (playnet planner knowledge recipes farm-commune-seed) (playnet planner scope root) (playnet planner vf schemas) (playnet planner beyond scenario) (srfi srfi-1) (playnet planner doors service) (playnet planner scope live)
             (playnet planner knowledge worlds berlin-baumscheiben)
             (playnet planner knowledge recipes berlin-festival-seed)
             ((playnet planner knowledge recipes farm-commune-seed) #:select (seed-farm-holds!))
             (playnet planner vf schemas) (playnet planner knowledge worlds bioregions)
             (goblins) (goblins vat) (goblins utils hashmap) (srfi srfi-1) (ice-9 format))
(define vat (spawn-vat #:name "festival-shape"))
(when (getenv "BACKEND") ((@ (playnet planner solve solver) set-backend!) (string->symbol (getenv "BACKEND"))))
(define extras? (getenv "EXTRAS"))
(define periods (string->number (or (getenv "PERIODS") "3")))
(with-vat vat
  (let* ((root (spawn-scope-root "B")))
    (seed-berlin-commune! root)
    (seed-farm-holds! root "berlin-commune-farm")
    (seed-berlin-festival-arm! root)
    (unless (getenv "NOFUT") (attach-festival-futures!))
    (when extras?
      (let ((as ($ root 'agent-store)) (obs ($ root 'observer)))
        ($ as 'add-agent (make-agent #:id "w-berlin-festival" #:type 'person #:name "Kiez gardener"
                                     #:primary-location "berlin-festival" #:classified-as '()))
        ($ obs 'seed-resource (make-economic-resource #:id "skill:w-berlin-festival:gardening"
                                                      #:name "w-berlin-festival gardening"
                                                      #:conforms-to "gardening"
                                                      #:accounting-quantity (make-measure 1 "each")
                                                      #:onhand-quantity (make-measure 1 "each")
                                                      #:primary-accountable "w-berlin-festival"))
        ($ as 'add-agent (make-agent #:id "EAAAcitizen1" #:type 'person #:name "probe one"
                                     #:classified-as '()))
        ($ as 'add-agent (make-agent #:id "EAAAcitizen2" #:type 'person #:name "probe two"
                                     #:classified-as '()))
        (when (and (equal? extras? "2") (not (equal? (getenv "SKILLS") "0")))
          (for-each (lambda (n)
                      (let ((id (string-append "EAAAcitizen" (number->string n))))
                        ($ as 'add-agent (make-agent #:id id #:type 'person #:name id
                                                     #:classified-as '()))
                        ($ obs 'seed-resource (make-economic-resource #:id (string-append "skill:" id ":gardening")
                                                                      #:name id
                                                                      #:conforms-to "gardening"
                                                                      #:accounting-quantity (make-measure 1 "each")
                                                                      #:onhand-quantity (make-measure 1 "each")
                                                                      #:primary-accountable id))))
                    (iota 20 3)))))
    (let* ((demand (if (and (equal? extras? "2") (not (equal? (getenv "WANTS") "0")))
                       (append-map (lambda (n) (map (lambda (t) (cons (string-append (or (getenv "WANT_SPEC") "salad") "~EAAAcitizen" (number->string n) "#" (or (getenv "WANT_PLACE") "hearth") "@" (number->string t)) 2)) (iota periods)))
                                   (iota 6 3))
                       '()))
           (demand (if (getenv "CROWD")             ; the crowd's own want at the ground, as the fold lays it
                       (append (map (lambda (t) (cons (string-append "meal~festival-crowd#berlin-festival@" (number->string t)) 60.0)) (iota periods))
                               demand)
                       demand))
           (floors (let ((f (getenv "FLOORS")))     ; e.g. "0,1" → the crowd's 3 kg floor at those periods
                     (if f (map (lambda (t) (cons (string-append "meal#berlin-festival@" (if (getenv "FLOOR_DATE") "2026-09-04" t)) (string->number (or (getenv "FLOOR_KG") "3.0"))))
                                (string-split f #\,))
                         '())))
           (al (plan-scope->alist root #:horizon (cons "2026-09-04" periods) #:demand demand
                                  #:repro-floors (if (getenv "BUDGET") '() floors)
                                  #:budgeted-floors (if (getenv "BUDGET") (map (lambda (f) (list (car f) (cdr f) (string->number (getenv "BUDGET")))) floors) '())
                                  #:allow-infeasible? (and (getenv "ALLOW") #t)
                                  #:backend (if (getenv "BACKEND") (string->symbol (getenv "BACKEND")) 'auto)
                                  #:maximin? (not (equal? (getenv "MAXIMIN") "0"))
                                  #:scenarios (if (getenv "DET") (list (make-planning-scenario "det" #f 1.0 '() #f)) '())
                                  #:reproduce? (not (equal? (getenv "REPRO") "0"))))
           (work (or (assq-ref al 'work) '())))
      (when (getenv "WARM")
        (let ((al2 (plan-scope->alist root #:horizon (cons "2026-09-04" periods) #:demand demand
                                      #:repro-floors (if (getenv "BUDGET") '() floors)
                                      #:budgeted-floors (if (getenv "BUDGET") (map (lambda (f) (list (car f) (cdr f) (string->number (getenv "BUDGET")))) floors) '())
                                      #:warm-x (assq-ref al 'x)
                                      #:reproduce? (not (equal? (getenv "REPRO") "0")))))
          (format #t "warm re-solve done~%")))
      (format #t "certificate: ~s~%" (let ((c (assq-ref al 'certificate))) (if (list? c) (filter (lambda (kv) (memq (car kv) '(feasible? optimal? stationarity mu min-slack backend))) c) c)))
      (format #t "met ~a   work rows ~a   places: ~a~%" (assq-ref al 'met) (length work)
              (length (delete-duplicates (filter-map (lambda (w) (assq-ref w 'at-location)) work))))
      (let ((mat (or (assq-ref al 'material) '())))
        (format #t "material rows ~a; first: ~s~%" (length mat) (if (pair? mat) (car mat) #f))
        (for-each (lambda (m) (format #t "   ~s~%" m))
                  (list-head (filter (lambda (m) (equal? (assq-ref m 'conforms-to) "meal")) mat)
                             (min 12 (length (filter (lambda (m) (equal? (assq-ref m 'conforms-to) "meal")) mat)))))
        (format #t "meal rows by action/place: ~s~%"
                (let ((h (make-hash-table)))
                  (for-each (lambda (m) (when (equal? (assq-ref m 'conforms-to) "meal")
                                          (let ((k (list (assq-ref m 'action) (assq-ref m 'at-location) (assq-ref m 'to-location))))
                                            (hash-set! h k (+ 1 (hash-ref h k 0))))))
                            mat)
                  (hash-map->list cons h)))
        (format #t "carry rows: ~a~%" (length (filter (lambda (w) (equal? (assq-ref w 'input-of) "carry-harvest")) work)))
        (format #t "carry effort by origin: ~s~%"
                (let ((h (make-hash-table)))
                  (for-each (lambda (w) (when (equal? (assq-ref w 'input-of) "carry-harvest")
                                          (let ((k (assq-ref w 'at-location)))
                                            (hash-set! h k (+ (hash-ref h k 0.0) (or (assq-ref w 'effort) 0.0))))))
                            work)
                  (map (lambda (kv) (cons (car kv) (/ (round (* 100 (cdr kv))) 100.0)))
                       (sort (hash-map->list cons h) (lambda (a b) (> (cdr a) (cdr b)))))))
        (format #t "meal INTO the ground by origin: ~s~%"
                (let ((h (make-hash-table)))
                  (for-each (lambda (m) (when (and (equal? (assq-ref m 'conforms-to) "meal") (equal? (assq-ref m 'to-location) "berlin-festival"))
                                          (let ((k (assq-ref m 'at-location)))
                                            (hash-set! h k (+ (hash-ref h k 0.0) (or (assq-ref m 'quantity) (assq-ref m 'qty) 0.0))))))
                            mat)
                  (sort (hash-map->list cons h) (lambda (a b) (> (cdr a) (cdr b))))))
        (let ((c (find (lambda (w) (equal? (assq-ref w 'input-of) "carry-harvest")) work)))
          (when c (format #t "a carry row: ~s~%" c)))))))
(format #t "done~%")
