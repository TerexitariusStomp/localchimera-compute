;;; tools/emit/wire-types-emit.scm — the page's row types, generated from the wire tables.
;;;
;;;   guile -L module tools/emit/wire-types-emit.scm [out]      default ui/app/wire-rows.ts
;;;
;;; Every row the page reads is written by a table registered in (playnet wire
;;; rows). This walks the registry and writes one TypeScript interface per
;;; table: each key with the type its KIND writes. The page's types are then
;;; what the server states; `make check-wire-types-fresh` holds the committed
;;; file to the tables.
;;;
;;; A table whose keys are symbols is a row of the OCapN wire (a planned flow as
;;; a door replies with it); the page reads the string-keyed tables, and those
;;; are what this emits. An entry of kind `any` reads `unknown`, or the type
;;; the entry states: (any "string | number").

(use-modules (playnet wire rows)
             (ice-9 format) (ice-9 ftw) (ice-9 rdelim)
             (srfi srfi-1))

;; The tables are found by loading every module under module/playnet whose text
;; registers one: the tree says which, so a table declared in a new module is
;; emitted without this script naming it.
(define (registering-modules)
  (let ((root "module/playnet") (found '()))
    (ftw root
         (lambda (path st flag)
           (when (and (eq? flag 'regular) (string-suffix? ".scm" path)
                      (not (string-suffix? "/wire/rows.scm" path)))
             (let ((text (call-with-input-file path read-string)))
               (when (or (string-contains text "(wire-table '") (string-contains text "(reply-table '"))
                 (set! found (cons path found)))))
           #t))
    (map (lambda (path)
           (map string->symbol
                (string-split (substring path (string-length "module/") (- (string-length path) 4)) #\/)))
         (sort found string<?))))
(for-each resolve-module (registering-modules))

(define type-name wire-type-name)          ; plan-need → WirePlanNeed, the registry's own spelling

(define (table-name-of t) (if (symbol? t) t (wire-table-name t)))

(define (kind-type kind)
  (case (if (pair? kind) (car kind) kind)
    ((str)                  "string")
    ((opt-str)              "string | null")
    ((int)                  "number")
    ((bool)                 "boolean")
    ((num)                  "number | null")
    ((strs)                 "readonly string[]")
    ((any)                  (if (and (pair? kind) (pair? (cdr kind))) (cadr kind) "unknown"))
    ((list)                 (string-append "readonly (" (kind-type (cadr kind)) ")[]"))
    ((map)                  (string-append "Record<string, " (kind-type (cadr kind)) ">"))
    ((rows gathered)        (string-append "readonly " (type-name (table-name-of (cadr kind))) "[]"))
    ((row)                  (string-append (type-name (table-name-of (cadr kind))) " | null"))
    ((some-rows)            (string-append "readonly " (type-name (table-name-of (cadr kind))) "[] | false"))
    ((some-row)             (string-append (type-name (table-name-of (cadr kind))) " | false"))
    ((omit-false)           (kind-type (cadr kind)))
    (else (error "wire-types-emit: no type for this kind" kind))))

(define (plain-key? k)
  (and (positive? (string-length k))
       (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (char=? c #\_))) (string->list k))
       (not (char-numeric? (string-ref k 0)))))

(define (entry-line entry)
  (let* ((key (car entry)) (kind (caddr entry))
         (optional? (and (pair? kind) (eq? (car kind) 'omit-false))))
    (format #f "  ~a~a: ~a;\n"
            (if (plain-key? key) key (string-append "\"" key "\""))
            (if optional? "?" "")
            (kind-type kind))))

(define (page-table? t) (every (lambda (e) (string? (car e))) (wire-table-entries t)))

(define (interface t)
  (string-append
   "export interface " (type-name (wire-table-name t)) " {\n"
   (string-concatenate (map entry-line (wire-table-entries t)))
   "}\n"))

(define (wire-rows-ts)
  (let ((tables (sort (filter page-table? (wire-tables))
                      (lambda (a b) (string<? (symbol->string (wire-table-name a))
                                              (symbol->string (wire-table-name b)))))))
    (string-append
     "// ui/app/wire-rows.ts — GENERATED by tools/emit/wire-types-emit.scm from the wire\n"
     "// tables (every module under module/playnet that registers one: wire/snapshot.scm,\n"
     "// wire/replies.scm, doors/record-rows.scm, doors/family/wire.scm, …). Do not edit;\n"
     "// `make wire-types-emit`.\n"
     "//\n"
     "// One interface per table: each key with the type the table's kind writes.\n"
     "// A figure reads `number | null`, null where absent; a key a row may leave\n"
     "// out is optional; a list that is false while there is none says so.\n"
     "\n"
     (string-join (map interface tables) "\n"))))

(define (main args)
  (let ((out (if (pair? (cdr args)) (cadr args) "ui/app/wire-rows.ts")))
    (call-with-output-file out (lambda (port) (display (wire-rows-ts) port)))
    (format (current-error-port) "wire-types-emit: ~a\n" out)))

(main (command-line))
