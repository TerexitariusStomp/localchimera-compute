#!/usr/bin/env -S guile -L module
;;; SPDX-License-Identifier: AGPL-3.0-or-later
!#
;;; tools/emit/reach-emit.scm — ui/app/reach-catalogue.ts from the reach kinds
;;;
;;;   reach-emit.scm [out]      the browser's copy of the kinds of way a person is reached
;;;
;;; A person's ways to be reached are named on both sides of the wire: the
;;; page keeps the list, offers the kinds and opens a value as a link
;;; (ui/app/reach.ts, ui/app/reach-view.ts, ui/app/tabs/contacts.ts), and the
;;; gateway reads a kind off a contact-point credential and judges its value
;;; (identity/contact-points.scm). (playnet identity reach-kinds) states the
;;; kinds once; this emit is how the page gets them. `make check-reach-fresh`
;;; regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-str . str) (ts-num . num)))
             (playnet identity reach-kinds)
             (ice-9 match) (srfi srfi-1))

(define (kind-ts k)
  (string-append "  { id: " (str (symbol->string (reach-id k))) ", label: " (str (reach-label k))
                 ", example: " (str (reach-example k)) ", link: " (str (reach-link k))
                 ", commune: " (if (reach-commune? k) "true" "false") " },\n"))

(define (catalogue-ts)
  (string-append
   "// ui/app/reach-catalogue.ts — GENERATED by tools/emit/reach-emit.scm from\n"
   "// module/playnet/identity/reach-kinds.scm. Do not edit; `make reach-emit`.\n"
   "//\n"
   "// The kinds of way a person can be reached: the word each goes by, an example\n"
   "// of its value, the link a value opens with (\"\" for none), and whether a\n"
   "// commune may be told it. The other kinds are for people: a card carries them.\n"
   "\n"
   "export interface ReachKind { readonly id: string; readonly label: string; readonly example: string;\n"
   "                             readonly link: string; readonly commune: boolean; }\n"
   "\n"
   "/** The kinds the app offers, in the order it offers them. */\n"
   "export const REACH_KINDS: readonly ReachKind[] = [\n"
   (string-concatenate (map kind-ts %reach-kinds))
   "];\n"
   "/** A value is one line of at most this many characters. */\n"
   "export const REACH_VALUE_MAX = " (num %reach-value-max) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: reach-emit.scm [out]\n") (exit 2)))
