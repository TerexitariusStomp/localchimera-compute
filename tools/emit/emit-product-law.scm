#!/usr/bin/env -S guile -L module
!#
;;; tools/emit/emit-product-law.scm — ui/app/legal-product.ts from the product's law
;;;
;;;   emit-product-law.scm [out]
;;;
;;; module/playnet/knowledge/law/product.scm states the product's own
;;; crossings, the features that trip them, and the notices the product shows
;;; about itself. This writes them as TypeScript, so the consent gate's version,
;;; the licence line and the attribution in the browser are those.
;;; `make check-product-law-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-str . str))))
(use-modules (playnet legal crossings)
             ((playnet legal registry) #:select (%stances %bill-keys))
             ((playnet knowledge law incumbent-readings) #:select (%reading-statuses))
             ((playnet knowledge law snapshot-build) #:select (%bill-json-keys))
             (playnet knowledge law product)
             (ice-9 format) (srfi srfi-1))

(define (strs xs) (string-join (map str xs) ", "))
(define (sym s) (str (symbol->string s)))

(define (emit port)
  (format port "// ui/app/legal-product.ts — GENERATED by tools/emit/emit-product-law.scm from
// module/playnet/knowledge/law/product.scm. Do not edit;
// `make product-law-emit`.
//
// The product's own law: the version of the terms a member accepts, the
// licence line and attribution it shows, and the features that trip a legal
// crossing with the doors that are each feature.

/** The date the terms and the privacy notice in force took effect — what a
 *  member's acceptance is of. */
export const LEGAL_VERSION = ~a;
/** The number the two documents call themselves by. */
export const DOCUMENT_VERSION = ~a;
/** The licence, as one line. */
export const LICENCE_LINE = ~a;
/** The attribution LICENSE-ADDITIONAL-TERMS.md asks every deployment to show. */
export const ATTRIBUTION = ~a;
export const TERMS_HREF = ~a;
export const PRIVACY_HREF = ~a;
export const ACCESSIBILITY_HREF = ~a;
/** The age the terms state (§8) as a floor, with no hard verification; an
 *  operator's own higher floor, if any, is stated at their contact, not here. */
export const MIN_AGE = ~a;
/** What this deployment has actually organized so far, as one sentence
 *  (product.scm's `deployment-status`) — the demo banner's own text, and the
 *  same sentence the terms and privacy notice quote in their marked figures. */
export const DEPLOYMENT_STATUS = ~a;

/** A legal crossing the product's own features trip. */
export interface ProductCrossing { id: string; kind: string; gloss: string; }
export const PRODUCT_CROSSINGS: ProductCrossing[] = [
~a];

/** A feature, the crossings it trips, the doors that are it, and where it sits. */
export interface ProductFeature {
  id: string; name: string; crossings: string[]; doors: string[]; section: string;
}
export const PRODUCT_FEATURES: ProductFeature[] = [
~a];

// ── the vocabulary of a bill, as the fold states it (legal/registry.scm) ──
/** What a bill means for doing the thing, from nothing asked to nothing allowed. */
export const STANCES = [~a] as const;
export type Stance = typeof STANCES[number];
/** The groups of a bill, as its JSON names them. */
export const BILL_KEYS = [~a] as const;
export type BillKey = typeof BILL_KEYS[number];
/** How a structural demand stands at a place (law/incumbent-readings.scm). */
export const READING_STATUSES = [~a] as const;
export type ReadingStatus = typeof READING_STATUSES[number];
"
          (str (product-notice 'legal-version))
          (str (product-notice 'document-version))
          (str (product-notice 'licence))
          (str (product-notice 'attribution))
          (str (product-notice 'terms))
          (str (product-notice 'privacy))
          (str (product-notice 'accessibility))
          (product-notice 'min-age)
          (str (product-notice 'deployment-status))
          (string-concatenate
           (map (lambda (row)
                  (format #f "  { id: ~a, kind: ~a, gloss: ~a },\n"
                          (sym (car row)) (sym (cadr row)) (str (caddr row))))
                *product-crossings*))
          (string-concatenate
           (map (lambda (id)
                  (let ((f (product-feature id)))
                    (format #f "  { id: ~a, name: ~a, crossings: [~a], doors: [~a], section: ~a },\n"
                            (sym id) (str (feature-name f))
                            (strs (map symbol->string (feature-crossings f)))
                            (strs (map (lambda (d) (format #f "~a/~a" (car d) (cdr d)))
                                       (feature-doors f)))
                            (str (feature-section f)))))
                (product-feature-ids)))
          (strs (map symbol->string %stances))
          (strs (map (lambda (k) (assq-ref %bill-json-keys k)) %bill-keys))
          (strs (map symbol->string %reading-statuses))))

(define out (if (> (length (command-line)) 1) (cadr (command-line)) "ui/app/legal-product.ts"))
(call-with-output-file out
  (lambda (port) (set-port-encoding! port "UTF-8") (emit port)))
(format #t "wrote ~a~%" out)
