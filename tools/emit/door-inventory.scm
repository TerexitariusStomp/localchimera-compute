;;; door-inventory.scm — the protocol's doors sorted by (object, kind).
;;;
;;; docs/planning/federation/federation-flow-map.md §7 item 10: every door is one of
;;; three statement kinds — a CONSTATIVE (a figure about the world, landing
;;; as a coefficient or a record), a PREFERENCE (a weight: a stance, a hand,
;;; a want, a willingness) or a PERFORMATIVE (a decision that fixes a column,
;;; raises a wall or projects a view) — or a READ, which states nothing.
;;; The kind is declared on the door itself (doors/protocol.scm `#:kind`), so this
;;; sort is read, never guessed.
;;;
;;;   guile -L module tools/emit/door-inventory.scm > docs/planning/faces/door-inventory.md

(use-modules (playnet doors protocol) (srfi srfi-1) (ice-9 format))

(define (kind-of d) (door-kind d))

(define %kinds '((constative . "Constative — a figure about the world: lands as a coefficient, a record, a reading")
                 (preference . "Preference — a weight: a stance, a hand, a want, a willingness, a delegation of weight")
                 (performative . "Performative — a decision: fixes a column, raises a wall, projects a view, opens or closes a thing")
                 (read . "Read — states nothing; answers")))

(define (args->string args)
  (let ((s (format #f "~s" args)))
    (if (> (string-length s) 70) (string-append (substring s 0 67) "…)") s)))

(define (emit)
  (format #t "# The doors, by object and kind\n\n")
  (format #t "_Generated by `tools/emit/door-inventory.scm` from `module/playnet/doors/protocol.scm` (protocol version ~a): every door sorted into the statement kind it carries — docs/planning/federation/federation-flow-map.md §1 and §7 item 10. The kind is declared on each door (`#:kind`); change the declaration, then regenerate._\n\n" %protocol-version)
  (format #t "One constative door per figure, one preference door per hand, one performative door per decision: the shape the protocol grows toward. Two doors of one kind on one object that name the same figure, hand or decision are the overlaps §6.1 of the map lists; they show up here as neighbours.\n\n")
  (let ((n (length %doors)))
    (format #t "| kind | doors |\n|---|---|\n")
    (for-each (lambda (k) (format #t "| ~a | ~a |\n" (car k) (count (lambda (d) (eq? (kind-of d) (car k))) %doors))) %kinds)
    (format #t "| all | ~a |\n\n" n))
  (for-each
   (lambda (object)
     (format #t "## ~a\n\n" object)
     (for-each
      (lambda (k)
        (let ((ds (filter (lambda (d) (and (eq? (door-object d) object) (eq? (kind-of d) (car k)))) %doors)))
          (unless (null? ds)
            (format #t "### ~a\n\n| door | args | auth | topic | reply |\n|---|---|---|---|---|\n" (cdr k))
            (for-each (lambda (d)
                        (format #t "| `~a` | `~a` | ~a | ~a | ~a |\n" (door-name d) (args->string (door-args d))
                                (door-auth d) (door-topic d) (door-reply d)))
                      (sort ds (lambda (a b) (string<? (symbol->string (door-name a)) (symbol->string (door-name b))))))
            (format #t "\n"))))
      %kinds))
   '(lobby session planner)))

(emit)
