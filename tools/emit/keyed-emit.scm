#!/usr/bin/env -S guile -L module
;;; SPDX-License-Identifier: AGPL-3.0-or-later
!#
;;; tools/emit/keyed-emit.scm — ui/app/keyed-doors.ts from the doors declared `#:keyed`
;;;
;;;   keyed-emit.scm [out]
;;;
;;; A door declared `#:keyed tap` (module/localchimera/doors/protocol.scm) is one whose act
;;; carries a token its caller minted for this ONE act, so a repeat of the request
;;; (a retry after a lost reply, an outbox flush) names the event that already stands.
;;; The page must mint that token once per act, before the first send, for every such
;;; door and no other: this is the list it reads, the seam handler's name and the index
;;; of the token among its arguments (the last), so no door is keyed twice by hand.
;;; `make check-keyed-fresh` regenerates and diffs the committed copy.

(use-modules (localchimera doors protocol)
             (localchimera protocol seam)
             (ice-9 match) (ice-9 format) (srfi srfi-1))

(define (keyed-handlers)
  "((handler-name . index) …) for every seam handler whose door is keyed, sorted."
  (sort (delete-duplicates
         (filter-map (lambda (d)
                       (let ((name (door-seam d)))
                         (and name
                              (cons name (- (handler-arity (handler-ref name)) 1)))))
                     (doors-keyed)))
        (lambda (a b) (string<? (car a) (car b)))))

(define (catalogue-ts)
  (string-append
   "// SPDX-License-Identifier: AGPL-3.0-or-later\n"
   "// ui/app/keyed-doors.ts — GENERATED by tools/emit/keyed-emit.scm from the doors\n"
   "// declared `#:keyed` (module/localchimera/doors/protocol.scm). Do not edit;\n"
   "// `make keyed-emit`.\n"
   "//\n"
   "// A keyed door's act carries a token its caller minted for that one act, so a repeat\n"
   "// of the request names the event that already stands. This is each seam handler\n"
   "// whose door is keyed, with the index of the token among its arguments (the last).\n"
   "\n"
   "export const KEYED: Readonly<Record<string, number>> = {\n"
   (string-concatenate (map (lambda (k) (format #f "  ~a: ~a,\n" (car k) (cdr k))) (keyed-handlers)))
   "};\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: keyed-emit.scm [out]\n") (exit 2)))
