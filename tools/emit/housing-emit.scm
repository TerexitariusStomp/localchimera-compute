#!/usr/bin/env -S guile -L module
;;; SPDX-License-Identifier: AGPL-3.0-or-later
!#
;;; tools/emit/housing-emit.scm — ui/app/housing-catalogue.ts from the housing standard
;;;
;;;   housing-emit.scm [out]      the browser's copy of the housing tables
;;;
;;; The housing catalogue (module/playnet/knowledge/catalogues/housing.scm)
;;; states what a person's night is owed, row by row with its source; the
;;; closure (catalogues/housing-substance.scm) states what a night in each dwelling type
;;; delivers, and what a night costs when a landlord is paid (recipes/
;;; dwelling.scm). The browser folds the person layer over the same numbers
;;; (ui/app/housing.ts), and this emit is how it gets them — nutrition-emit's
;;; twin. `make check-housing-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-num . num) (ts-str . str))))
(use-modules (playnet knowledge catalogues housing)
             (playnet knowledge catalogues housing-substance)
             ((playnet knowledge recipes dwelling) #:select (%rent-eur-per-night))
             (ice-9 match) (ice-9 format) (srfi srfi-1))


(define (catalogue-ts)
  (string-append
   "// ui/app/housing-catalogue.ts — GENERATED by tools/emit/housing-emit.scm from\n"
   "// module/playnet/knowledge/catalogues/housing.scm, catalogues/housing-substance.scm\n"
   "// and recipes/dwelling.scm. Do not edit; `make housing-emit`.\n"
   "//\n"
   "// The standard every person's night is owed (L0, each row with its source),\n"
   "// what a night in each dwelling type delivers of the gradient rows, and the\n"
   "// price of a night when a landlord is paid. housing.ts holds the person\n"
   "// layer; the numbers live here, and here only because the catalogue wrote them.\n"
   "\n"
   "/** One row of the standard: a GRADIENT is a quantity the night delivers, a GATE a certificate the dwelling holds (1) or not (0). Its FN is what it does for rest: an outcome of the night, a proxy for one, a service around sleep, or access to the place. */\n"
   "export interface HousingRow { id: string; name: string; group: \"gradient\" | \"gate\"; unit: string; floor: number; ceiling: number | null; w: number; fn: \"outcome\" | \"proxy\" | \"service\" | \"access\"; source: string; }\n"
   "\n"
   "/** The named figures of the climate and person layers — the catalogue's own, so housing.ts types none of them twice. */\n"
   "export const ACCLIMATISED_CEILING = " (num %acclimatised-ceiling) ";\n"
   "export const WARMTH_RAISED = " (num %warmth-raised) ";\n"
   "export const WARMTH_ELDER_AGE = " (num %warmth-elder-age) ";\n"
   "export const WARMTH_YOUNG_AGE = " (num %warmth-young-age) ";\n"
   "export const CHILD_SHARE_AGE = " (num %child-share-age) ";\n"
   "export const OUTDOOR_CREDIT = " (num %outdoor-credit) ";\n"
   "/** The regions without a winter: no floor of warmth is asked there. */\n"
   "export const WINTERLESS_REGIONS: string[] = [" (string-join (map str %winterless-regions) ", ") "];\n"
   "\n"
   "/** L0 · the base: what every person's night is owed, in the catalogue's order. */\n"
   "export const HOUSING_STANDARD: HousingRow[] = [\n"
   (string-concatenate
    (map (lambda (r)
           (format #f "  { id: ~a, name: ~a, group: ~a, unit: ~a, floor: ~a, ceiling: ~a, w: ~a,\n    fn: ~a,\n    source: ~a },\n"
                   (str (list-ref r 0)) (str (list-ref r 1)) (str (list-ref r 2)) (str (list-ref r 3))
                   (num (list-ref r 4)) (if (list-ref r 5) (num (list-ref r 5)) "null") (num (list-ref r 6))
                   (str (symbol->string (housing-row-function (list-ref r 0))))
                   (str (list-ref r 7))))
         *housing-standard*))
   "];\n"
   "\n"
   "/** The closure's type table: what one person-night in a dwelling of this type delivers of each gradient row. */\n"
   "export const DWELLING_TYPES: Record<string, Record<string, number>> = {\n"
   (string-concatenate
    (map (lambda (t)
           (format #f "  ~a: { ~a },\n" (str (car t))
                   (string-join (map (lambda (c) (format #f "~a: ~a" (str (car c)) (num (cdr c)))) (cdr t)) ", ")))
         *dwelling-composition*))
   "};\n"
   "\n"
   "/** EUR per person-night by type when a landlord is paid — a market rate, political and edited in the closure; a unit may state its own. */\n"
   "export const DWELLING_EUR_PER_NIGHT: Record<string, number> = {\n"
   (string-concatenate
    (map (lambda (e) (format #f "  ~a: ~a,\n" (str (car e)) (num (cdr e)))) *dwelling-eur-per-night*))
   "};\n"
   "\n"
   "/** The rent recipe's own price of a night (recipes/dwelling.scm): what the commons pays a landlord for a night no lent bed covers. */\n"
   "export const RENT_EUR_PER_NIGHT = " (num %rent-eur-per-night) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: housing-emit.scm [out]\n") (exit 2)))
