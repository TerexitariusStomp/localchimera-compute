#!/usr/bin/env -S guile -L module
!#
;;; tools/emit/offline-emit.scm — ui/app/offline-doors.ts from the doors declared `#:offline`
;;;
;;;   offline-emit.scm [out]
;;;
;;; A door declared `#:offline read` is answered from the device's copy of the scope
;;; when no gateway is in reach; one declared `#:offline act` (or `(act ARG)`, ARG
;;; the argument that stamps the act's instant) lands on that copy and waits for the
;;; gateway (ui/app/outbox.ts). The page's list of such doors, and where an act's
;;; instant stands among its arguments, is this table and nothing hand-written:
;;; ui/app/outbox.ts QUEUED and ui/app/demo/seat.ts read it, and a test holds the
;;; device's own doors (doors/page-scope.scm) to it.
;;; `make check-offline-fresh` regenerates and diffs the committed copy.

(use-modules (playnet doors protocol)
             (ice-9 match) (ice-9 format) (srfi srfi-1))

(define (catalogue-ts)
  (string-append
   "// ui/app/offline-doors.ts — GENERATED by tools/emit/offline-emit.scm from the doors\n"
   "// declared `#:offline` (module/playnet/doors/protocol.scm). Do not edit;\n"
   "// `make offline-emit`.\n"
   "//\n"
   "// Each seam handler the device answers with no gateway in reach: a `read` is answered\n"
   "// from the device's copy of the scope, an `act` lands on it and waits for the gateway.\n"
   "// `at` is the index, among the handler's arguments, of the instant an act is stamped\n"
   "// with when it states none; null where the act's ids name it.\n"
   "\n"
   "export type OfflineKind = \"act\" | \"read\";\n"
   "export const OFFLINE: Readonly<Record<string, { kind: OfflineKind; at: number | null }>> = {\n"
   (string-concatenate
    (map (lambda (h) (format #f "  ~a: { kind: \"~a\", at: ~a },\n" (car h) (cadr h) (or (caddr h) "null")))
         (offline-handlers)))
   "};\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: offline-emit.scm [out]\n") (exit 2)))
