#!/usr/bin/env -S guile -L module
;;; SPDX-License-Identifier: AGPL-3.0-or-later
!#
;;; tools/emit/limits-emit.scm — ui/app/limits-catalogue.ts from the gateway's limits
;;;
;;;   limits-emit.scm [out]      the browser's copy of the sizes the gateway refuses past
;;;
;;; The gateway refuses a document or a picture over its bound whole, so the
;;; page has to size what it sends against the same figures. (playnet gateway
;;; limits) states them once; this emit is how the page gets them.
;;; `make check-limits-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-num . num)))
             (playnet vf facts limits)
             (ice-9 match))

(define (catalogue-ts)
  (string-append
   "// ui/app/limits-catalogue.ts — GENERATED by tools/emit/limits-emit.scm from\n"
   "// module/playnet/vf/facts/limits.scm. Do not edit; `make limits-emit`.\n"
   "//\n"
   "// The sizes the gateway refuses past. What the page sends is sized against\n"
   "// these before it is sent, since a body over its bound is refused whole.\n"
   "\n"
   "/** One person's synced document (contacts, credentials, the log's backup), measured as the gateway writes it. */\n"
   "export const USER_DATA_MAX_BYTES = " (num %max-user-data-bytes) ";\n"
   "/** The pictures of one read together, in base64 characters. */\n"
   "export const PICTURE_MAX_CHARS = " (num %picture-max-chars) ";\n"
   "/** The picture a count names, in base64 characters. */\n"
   "export const EVIDENCE_MAX_CHARS = " (num %evidence-max-chars) ";\n"
   "/** A feedback body: text, context and one screenshot. */\n"
   "export const FEEDBACK_MAX_BYTES = " (num %feedback-max-bytes) ";\n"
   "/** A report of unlawful or harmful content: text only. */\n"
   "export const REPORT_MAX_BYTES = " (num %report-max-bytes) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: limits-emit.scm [out]\n") (exit 2)))
