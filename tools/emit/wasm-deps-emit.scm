;;; wasm-deps-emit.scm — the wasm prerequisite lists, written from the import closures.
;;;
;;; The four browser/*.wasm rules took hand-written lists of the (playnet …) modules
;;; their entry imports, and a missing entry means make reports a stale bundle as
;;; up to date. The closure walker (tools/lint/wasm-deps.scm) already computes the
;;; list for the check; this writes it, so the list is never typed. The Makefile
;;; includes the result and adds, per bundle, the few modules a static walk cannot
;;; see (a `primitive-load`, a runtime include) as hand `*_WASM_EXTRA` lists.
;;;
;;; Usage: guile -L module tools/emit/wasm-deps-emit.scm OUT      (make wasm-deps-emit)

(use-modules (ice-9 match) (srfi srfi-1) (srfi srfi-13))

(load (string-append (getcwd) "/tools/lint/wasm-deps.scm"))   ; `closure`, and the opaque-form record (relative to the repo root)

(define %bundles
  '(("REPL_WASM_CLOSURE"      . "hoot/repl.scm")
    ("DAY_BOOT_WASM_CLOSURE"  . "hoot/day-boot.scm")
    ("FAMILY_WASM_CLOSURE"    . "hoot/family-worker.scm")
    ("SCOPE_WASM_CLOSURE"     . "hoot/scope-worker.scm")))

(define (emit out)
  (call-with-output-file out
    (lambda (port)
      (format port "# GENERATED by tools/emit/wasm-deps-emit.scm (make wasm-deps-emit): do not edit.~%")
      (format port "# The (playnet ...) import closure of each wasm entry, one file per line;~%")
      (format port "# the Makefile adds what a static walk cannot see (the *_WASM_EXTRA lists).~%")
      (for-each
       (match-lambda
         ((var . entry)
          (let ((deps (closure entry)))
            (format port "~%~a = \\~%" var)
            (let loop ((ds deps))
              (match ds
                (() #t)
                ((d) (format port "  ~a~%" d))
                ((d . rest) (format port "  ~a \\~%" d) (loop rest)))))))
       %bundles))))

(match (cdr (command-line))
  ((out)
   (emit out)
   (unless (null? *opaque*)
     (for-each (lambda (o) (format (current-error-port) "  ~a: ~a~%" (car o) (cdr o))) (reverse *opaque*))
     (format (current-error-port) "wasm-deps-emit: unfollowable form(s); the lists may be incomplete~%")
     (exit 3)))
  (_ (format (current-error-port) "usage: wasm-deps-emit.scm OUT~%") (exit 2)))
