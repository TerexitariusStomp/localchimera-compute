#!/usr/bin/env -S guile -L module
!#
;;; tools/emit/actions-emit.scm — ui/app/actions-catalogue.ts from the action table
;;;
;;;   actions-emit.scm [out]      the browser's copy of the action table's readings
;;;
;;; The ValueFlows action table stands once (vf/schemas.scm) and every reading of it
;;; once beside it (vf/formulas/actions.scm): which acts are a process's inputs and
;;; outputs, which use a stock up, occupy a means or are labour, which relocate,
;;; which adjust the books, and the sign an act puts on a stock on hand. The page
;;; asks the same questions of a flow, a plan row and a log entry, so it reads this
;;; generated copy and spells no verb set by hand (beyond-valueflows.md §6.2 step 5).
;;; `make check-actions-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-str . str)))
             ((playnet vf schemas) #:select (*action-definitions*))
             (playnet vf formulas actions)
             ((playnet observation log-observe) #:select (%log-actions))
             (ice-9 match) (srfi srfi-1))

(define (sym-list syms) (string-append "[" (string-join (map (lambda (s) (str (symbol->string s))) syms) ", ") "]"))
(define (set-line doc name syms)
  (string-append "/** " doc " */\nexport const " name ": readonly string[] = " (sym-list syms) ";\n"))
(define (pred-line doc name set)
  (string-append "/** " doc " */\nexport const " name " = (a: string | null | undefined): boolean => !!a && " set ".includes(a);\n"))

(define all-actions (map car *action-definitions*))

(define (catalogue-ts)
  (string-append
   "// ui/app/actions-catalogue.ts — GENERATED by tools/emit/actions-emit.scm from\n"
   "// module/playnet/vf/schemas.scm and vf/formulas/actions.scm. Do not edit; `make actions-emit`.\n"
   "//\n"
   "// The action table's readings, so the page asks of a verb what the planner asks.\n"
   "\n"
   (set-line "Every action of the table, in its order." "ACTIONS" all-actions)
   (set-line "A flow INTO a process." "INPUT_ACTIONS" process-input-actions)
   (set-line "A flow OUT of a process (a service is made and handed over in one act)." "OUTPUT_ACTIONS" process-output-actions)
   (set-line "An input that is gone after the process." "USING_UP_ACTIONS" using-up-actions)
   (set-line "An input that takes a stock off hand (used up, combined, picked up, accepted)." "CONSUMING_ACTIONS" consuming-actions)
   (set-line "An act that occupies a means for a while." "OCCUPYING_ACTIONS" occupying-actions)
   (set-line "An act that IS labour." "LABOUR_ACTIONS" labour-actions)
   (set-line "An act that carries effort: labour, or a means occupied for hours." "EFFORT_ACTIONS" effort-actions)
   (set-line "An act that moves a thing from one place to another." "RELOCATING_ACTIONS" relocating-actions)
   (set-line "What a process makes: an output that puts a quantity on hand, less the relocations." "MAKING_ACTIONS" making-actions)
   (set-line "What comes newly into being: a thing produced, a service delivered." "CREATING_ACTIONS" creating-actions)
   (set-line "A count that found the books off: raise, lower." "ADJUSTMENT_ACTIONS" *adjustment-actions*)
   (set-line "A hand-off between agents: rights or custody move." "TRANSFERRING_ACTIONS" transferring-actions)
   (set-line "The acts a spoken log entry can narrate (observation/log-observe.scm)." "LOG_ACTIONS" (map cdr %log-actions))
   "\n"
   (pred-line "A flow into a process." "isInput" "INPUT_ACTIONS")
   (pred-line "A flow out of a process." "isOutput" "OUTPUT_ACTIONS")
   (pred-line "An input gone after the process." "isUsingUp" "USING_UP_ACTIONS")
   (pred-line "A means occupied." "isOccupying" "OCCUPYING_ACTIONS")
   (pred-line "Labour." "isLabour" "LABOUR_ACTIONS")
   (pred-line "A relocation." "isRelocating" "RELOCATING_ACTIONS")
   (pred-line "What a process makes." "isMaking" "MAKING_ACTIONS")
   (pred-line "What comes newly into being." "isCreating" "CREATING_ACTIONS")
   (pred-line "A count's adjustment." "isAdjustment" "ADJUSTMENT_ACTIONS")
   "\n"
   "/** The sign an act puts on a stock on hand: +1 an increment, -1 a decrement, 0 none (a use, a work). */\n"
   "export const ONHAND_SIGN: Readonly<Record<string, 1 | -1 | 0>> = {\n"
   (string-join (map (lambda (a) (string-append "  " (str (symbol->string a)) ": " (number->string (or (onhand-sign a) 0)))) all-actions) ",\n")
   "\n};\n"
   "export const onhandSign = (a: string | null | undefined): 1 | -1 | 0 => (a && ONHAND_SIGN[a]) || 0;\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: actions-emit.scm [out]\n") (exit 2)))
