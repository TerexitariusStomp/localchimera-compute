;;; tools/emit/fdc-snapshot.scm — slice USDA FoodData Central (SR Legacy) into the
;;; composition rows the food sources bind.
;;;
;;;   guile -L module tools/emit/fdc-snapshot.scm <dump-dir> <out.scm>
;;;
;;; DUMP-DIR holds the unzipped FoodData_Central_sr_legacy_food_csv_2018-04
;;; release (food.csv, nutrient.csv, food_nutrient.csv). The slice written to
;;; OUT is a Scheme datum: the release, the archive's sha256 as pinned below,
;;; the nutrients read (id name unit), and per bound FDC food its description
;;; and (nutrient-id . amount-per-100g) rows — only the foods *food-sources*
;;; binds and the nutrients *fdc-nutrients* maps, so the slice is small and
;;; the repo carries no dump. `make fdc-snapshot` fetches and verifies the
;;; archive before calling this. catalogues/food-sources.scm reads the committed slice
;;; (its `food-macros`), so this tool loads the slice it is about to replace: a
;;; fresh checkout regenerates from the committed one, never from nothing.

(use-modules (ice-9 rdelim) (ice-9 format) (ice-9 pretty-print) (srfi srfi-1)
             (playnet knowledge catalogues food-sources))

(define %release "FoodData_Central_sr_legacy_food_csv_2018-04")
(define %archive-url "https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_sr_legacy_food_csv_2018-04.zip")
(define %archive-sha256 "b80817294b8850530aaedf2e515c02593b1824f763a0ff356e5c2081643e6fd0")

(define (csv-fields line)                       ; every field is quoted; none carries a quote or comma inside
  (map (lambda (f) (string-trim-both f #\")) (string-split line #\,)))
(define (for-each-row path proc)
  (call-with-input-file path
    (lambda (p)
      (read-line p)                             ; the header
      (let loop ((l (read-line p)))
        (unless (eof-object? l) (proc (csv-fields l)) (loop (read-line p)))))))

(define (main args)
  (let* ((dir (cadr args)) (out (caddr args))
         (food-ids (delete-duplicates (map (lambda (s) (food-source-id (cdr s))) *food-sources*)))
         (nut-ids (fdc-nutrient-ids))
         (names (make-hash-table)) (nutrients '()) (rows (make-hash-table)))
    (for-each-row (string-append dir "/food.csv")
      (lambda (f) (let ((id (string->number (car f))))
                    (when (member id food-ids) (hash-set! names id (caddr f))))))
    (for-each-row (string-append dir "/nutrient.csv")
      (lambda (f) (let ((id (string->number (car f))))
                    (when (member id nut-ids) (set! nutrients (cons (list id (cadr f) (caddr f)) nutrients))))))
    (for-each-row (string-append dir "/food_nutrient.csv")
      (lambda (f) (let ((fid (string->number (cadr f))) (nid (string->number (caddr f))) (amt (string->number (cadddr f))))
                    (when (and (member fid food-ids) (member nid nut-ids) amt)
                      (hash-set! rows fid (cons (cons nid amt) (hash-ref rows fid '())))))))
    (for-each (lambda (id) (unless (hash-ref names id #f) (error "fdc-snapshot: no such food in the release" id))) food-ids)
    (call-with-output-file out
      (lambda (p)
        (format p ";;; fdc-sr-legacy.scm — GENERATED by tools/emit/fdc-snapshot.scm from ~a; do not edit.~%" %release)
        (format p ";;; USDA FoodData Central, SR Legacy (public domain). Amounts per 100 g.~%")
        (format p ";;; Archive ~a~%;;; sha256  ~a~%~%" %archive-url %archive-sha256)
        (format p "(define-module (playnet knowledge data fdc-sr-legacy) #:export (%fdc-slice))~%~%(define %fdc-slice~%  '")
        (pretty-print
         `((release . ,%release) (sha256 . ,%archive-sha256)
           (nutrients . ,(sort nutrients (lambda (a b) (< (car a) (car b)))))
           (foods . ,(map (lambda (id) (list id (hash-ref names id) (sort (hash-ref rows id '()) (lambda (a b) (< (car a) (car b))))))
                          (sort food-ids <))))
         p)
        (format p ")~%")))
    (format #t "fdc-snapshot: ~a foods, ~a nutrients → ~a~%" (length food-ids) (length nutrients) out)))
(main (command-line))
