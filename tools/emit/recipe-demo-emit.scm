#!/usr/bin/env -S guile -L module
!#
;;; tools/emit/recipe-demo-emit.scm — ui/app/recipe-demo-standing.ts from the demo's runs
;;;
;;;   recipe-demo-emit.scm [out]   the demo recipes' standing, as the wire carries it
;;;
;;; The page shows a recipe's standing — its curve per flow, the word for the
;;; curve's bend, how far its record reaches, what it yields right now —
;;; exactly as the gateway wires it. Where no gateway stands the page shows
;;; demo recipes, and their standing is this file's: the demo's RUNS are
;;; stated here, and the standing is read off them by the very functions a
;;; live scope's is (planner/solve/recipe-response.scm for the reading,
;;; the recipe-response table of doors/record-rows.scm for the shape). So the page holds no
;;; copy of the reading: it draws what it is handed, live or demo alike.
;;; `make check-recipe-demo-fresh` regenerates and diffs the committed copy.

(use-modules ((playnet utils ts-emit) #:select ((ts-num . num)))
             (playnet solve recipe-response)
             ((playnet vf formulas shocks) #:select (%stress-band))
             ((playnet doors record-rows) #:select (record-context))
             (playnet wire rows)
             (json)
             (ice-9 match) (srfi srfi-1))

;; ── the demo's runs ──────────────────────────────────────────────────────────
;; One row per demo recipe that has run:
;;   (id output channel regime live-stress work-spec hours runs)
;; CHANNEL is the flow of its own the weather pressed, LIVE-STRESS the stress
;; on that flow right now, RUNS ((day stress capture) …), and each run's claim
;; HOURS of WORK-SPEC, met by the capture's share.
(define %demo-runs
  `(;; robust: the price of vegetables swings, the kitchen holds steady
    ("rp-cooked-meal" "meal" (consume . "vegetables") probability-free 5 "cooking" 0.6
     (("2026-09-01" 1 86) ("2026-09-02" 2 84) ("2026-09-04" 4 83)
      ("2026-09-05" 5 81) ("2026-09-07" 7 80) ("2026-09-09" 9 79)))
    ;; fragile: the heap holds under light heat, then fails faster with every degree
    ("rp-waste-hole" "compost" (produce . "compost") probability-free 8 "composting" 1.5
     (("2026-08-12" 2 90) ("2026-08-19" 4 88) ("2026-08-26" 6 75)
      ("2026-09-02" 8 40) ("2026-09-09" 9 12)))
    ;; two runs in, both under drought: a curve the plan reads, a bend yet to show
    ("rp-garden-greens" "vegetables" (produce . "vegetables") probability-free 4 "growing" 0.8
     (("2026-09-10" 3 70) ("2026-09-17" 5 55)))
    ;; a gain under stress, and licensed: a regime claim of thin tails and a stable
    ;; process stands over this domain, so the acceleration carries its error
    ("rp-sourdough" "bread" (consume . "flour") statistical 7 "baking" 1.0
     (("2026-09-03" 1 56) ("2026-09-10" 3 60) ("2026-09-17" 5 68)
      ("2026-09-24" 7 80) ("2026-10-01" 9 95)))))

;; ── the record a live scope's standing would hand out (scope-standing) ───────
(define (demo-record row)
  (match row
    ((id output channel regime live work-spec hours runs)
     (let* ((log (map (match-lambda
                        ((day stress capture)
                         (list day (exact->inexact capture) (list (cons channel (exact->inexact stress)))
                               (list (list 'work work-spec hours
                                           (/ (round (* hours capture)) 100.0))))))
                      runs))
            (rows (recipe-response-report (map (lambda (r) (cons (cadr r) (caddr r))) log)
                                          #:regime regime))
            (curves (map (lambda (r) (cons (assq-ref r 'channel) (assq-ref r 'curve))) rows)))
       `((id . ,id) (output . ,output) (curves . ,curves) (rows . ,rows)
         (yield . ,(response-factor curves (list (cons channel (exact->inexact live)))))
         (runs . ,log))))))

;; ── a standing as the wire writes it ─────────────────────────────────────────
;; The recipe-response table writes the row; JSON reads a whole figure as the
;; integer it is (81.0 ⇒ 81).
(define (response-row r records)
  (wire-row* (wire-table-ref 'recipe-response) r
             (record-context "demo" #f #f #f #f #f #:responses records)))
(define (->json x)
  (cond ((vector? x) (list->vector (map ->json (vector->list x))))
        ((and (pair? x) (pair? (car x)) (string? (caar x)))
         (map (lambda (kv) (cons (car kv) (->json (cdr kv)))) x))
        ((and (number? x) (inexact? x) (integer? x)) (inexact->exact x))
        (else x)))

(define (standing-ts)
  (let* ((records (map demo-record %demo-runs))
         (entries (map (lambda (r) (cons (assq-ref r 'id) (->json (response-row r records))))
                       records)))
    (string-append
     "// ui/app/recipe-demo-standing.ts — GENERATED by tools/emit/recipe-demo-emit.scm from\n"
     "// the demo's runs, read by module/playnet/solve/recipe-response.scm and shaped by\n"
     "// module/playnet/doors/record-rows.scm's recipe-response table. Do not edit; `make recipe-demo-emit`.\n"
     "//\n"
     "// The demo recipes' standing as the wire carries a live scope's: per flow the\n"
     "// curve, its reach, the word for its bend and the runs behind it; the position,\n"
     "// the margin, and what the recipe yields under the stress live right now.\n"
     "\n"
     "import type { ScopeRecipe } from './seam.js';\n"
     "\n"
     "/** The stress axis: 0 is calm, this the heaviest a flow can be pressed (shocks.scm %stress-band). */\n"
     "export const STRESS_BAND = " (num %stress-band) ";\n"
     "\n"
     "export const DEMO_STANDING: Record<string, Pick<ScopeRecipe, \"standing\" | \"profile\" | \"yield\" | \"margin\">> = "
     (scm->json-string entries #:pretty #t)
     ";\n")))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (standing-ts) p))))
  (() (display (standing-ts)))
  (_ (display "usage: recipe-demo-emit.scm [out]\n") (exit 2)))
