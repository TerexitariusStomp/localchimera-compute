#!/usr/bin/env -S guile -L module
;;; SPDX-License-Identifier: AGPL-3.0-or-later
!#
;;; tools/emit/count-emit.scm — ui/app/count-catalogue.ts from the counting rules
;;;
;;;   count-emit.scm [out]      the browser's copy of the counting constants
;;;
;;; A count is read and written on both sides of the wire: the planner lays a
;;; planned count's process as count~<regime>~<resource id> and lands an
;;; unplanned count's event under count:<technique> (counting.scm), names the
;;; picture a count was read from by hash (observation/evidence.scm) and the
;;; ballot of a contest of a count (counting.scm), decides by
;;; one tolerance whether a difference lands (adjustment.scm), and gives a thing
;;; a code from one alphabet (labels.scm). The page reads the same grammar and
;;; prints the same codes (ui/app/count.ts, ui/app/labels.ts), and this emit is
;;; how it gets the constants. `make check-count-fresh` regenerates and diffs
;;; the committed copy.

(use-modules ((localchimera utils ts-emit) #:select ((ts-num . num) (ts-str . str)))
             (localchimera vf formulas counting)
             (localchimera vf facts labels)
             ((localchimera observation adjustment) #:select (%count-tolerance))
             (localchimera observation evidence)
             (ice-9 match) (srfi srfi-1))

(define (strings xs) (string-append "[" (string-join (map str xs) ", ") "]"))

(define (catalogue-ts)
  (string-append
   "// ui/app/count-catalogue.ts — GENERATED by tools/emit/count-emit.scm from\n"
   "// module/localchimera/vf/formulas/counting.scm, vf/facts/labels.scm and observation/adjustment.scm.\n"
   "// Do not edit; `make count-emit`.\n"
   "//\n"
   "// The grammar of a planned count's process, the techniques a count names, the\n"
   "// figure under which the ledger agrees with a count, and the alphabet a thing's\n"
   "// code is drawn from. count.ts and labels.ts read them; the planner wrote them.\n"
   "\n"
   "/** A planned count's process begins with this: count~<regime>~<resource id>. */\n"
   "export const COUNT_PREFIX = " (str %count-prefix) ";\n"
   "/** How a planned count is disclosed. */\n"
   "export const COUNT_REGIMES: readonly string[] = " (strings %count-regimes) ";\n"
   "/** The regimes whose counter states a figure before seeing the ledger's. */\n"
   "export const BLIND_REGIMES: readonly string[] = " (strings %count-blind-regimes) ";\n"
   "/** An unplanned count's event names its technique after this: count:stated. */\n"
   "export const COUNT_TECHNIQUE_PREFIX = " (str %count-technique-prefix) ";\n"
   "/** How a person came by a count. */\n"
   "export const COUNT_TECHNIQUES = " (strings %count-techniques) " as const;\n"
   "/** A difference smaller than this is the ledger agreeing. */\n"
   "export const COUNT_AGREES = " (num %count-tolerance) ";\n"
   "\n"
   "/** A picture a count was read from is named by its hash: this prefix, then the digits. */\n"
   "export const EVIDENCE_PREFIX = " (str %evidence-hash-prefix) ";\n"
   "/** Exactly this many lower-case hex digits follow the prefix. */\n"
   "export const EVIDENCE_DIGITS = " (num %evidence-hash-digits) ";\n"
   "/** The ballot of a contest begins with this, then the count's adjustment id. */\n"
   "export const CONTEST_PREFIX = " (str %contest-prefix) ";\n"
   "\n"
   "/** The alphabet of a thing's code: Crockford's, with no I, L, O or U. */\n"
   "export const LABEL_ALPHABET = " (str %label-alphabet) ";\n"
   "/** A code is this many characters. */\n"
   "export const LABEL_LENGTH = " (num %label-length) ";\n"
   "/** A printed symbol carries this, then the code. */\n"
   "export const LABEL_SCHEME = " (str %label-scheme) ";\n"))

(match (cdr (command-line))
  ((out) (call-with-output-file out (lambda (p) (display (catalogue-ts) p))))
  (() (display (catalogue-ts)))
  (_ (display "usage: count-emit.scm [out]\n") (exit 2)))
