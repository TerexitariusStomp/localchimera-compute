FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    guile-3.0 guile-gnutls git ca-certificates \
    && git clone --depth 1 https://git.dthompson.us/guile-websocket.git /tmp/guile-websocket \
    && mkdir -p /usr/share/guile/site/3.0/web/socket \
    && cp /tmp/guile-websocket/web/socket/*.scm /usr/share/guile/site/3.0/web/socket/ \
    && rm -rf /tmp/guile-websocket \
    && apt-get purge -y git ca-certificates && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY xorg-relay.scm .

ENV PORT=9090
EXPOSE 9090

CMD guile xorg-relay.scm "$PORT"
