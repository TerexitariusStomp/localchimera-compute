[Unit]
Description=GNU Shepherd (user) — localchimera service supervisor on server-1
Documentation=man:shepherd(1)
# We pre-build Guix profiles in ExecStartPre so shepherd-init.scm can rely
# on bin paths existing. install.sh seeds the profiles once; this keeps
# them in sync with the manifests on every restart.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=PATH=%h/.config/guix/current/bin:%h/.guix-profile/bin:/usr/bin:/bin
ExecStartPre=%h/localchimera/deploy/server-1/install.sh --pre-start
ExecStart=%h/.guix-profile/bin/shepherd \
  --config=%h/localchimera/deploy/server-1/shepherd-init.scm \
  --socket=%t/shepherd/socket \
  --pid=%t/shepherd/pid \
  --logfile=%h/.local/state/localchimera/log/shepherd.log
Restart=on-failure
RestartSec=5
# shepherd already supervises its children; don't let systemd kill the
# whole tree on stop. Stop-mode "process" leaves children running until
# shepherd shuts them down cleanly.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=default.target
