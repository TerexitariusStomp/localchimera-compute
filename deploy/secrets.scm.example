;;; deploy/guix/secrets.scm — local secrets, NOT committed
;;;
;;; Copy this file to secrets.scm and fill in your values.
;;; Loaded by machines.scm at deploy time via primitive-load.
;;; Environment variables set here are available to service definitions
;;; but never enter the Guix store.
;;;
;;; This file is gitignored. Do not commit secrets.scm.

;; API keys for the OCapN gateway (comma-separated if multiple)
;; Used by: localchimera-gateway service → (getenv "API_KEYS")
(setenv "API_KEYS" "")

;; Mosquitto MQTT broker password — authenticates the localchimera user
;; against the local MQTT broker. Without this, any local process
;; could inject fake deficit signals and trigger XMR spend + VM
;; provisioning. The password file is generated by mosquitto_passwd
;; at activation time. The same password is written to
;; /var/lib/localchimera/mosquitto/mqtt-password.txt for the MQTT
;; subscriber scripts to read.
;; Used by: machines.scm activation → mosquitto_passwd
(setenv "MOSQUITTO_PASSWORD" "")

;; KERIA keystore encryption passcode (22-char CESR salt)
;; Used by: keria service → --passcode flag
;; Leave empty to run without keystore encryption.
(setenv "KERIA_PASSCODE" "")

;; KERIA_BRAN — 21-char CESR passcode for the GATEWAY's Signify client
;; (distinct from KERIA_PASSCODE above, which encrypts the KERIA
;; server's own keystore). This is the credential that arms the KERIA
;; client tier: without it, the gateway boots with acdc-store local-
;; durable and the IPEX poller / witness replication / KERIA-governor
;; checks inert (see server/gateway.scm's boot line). Generate with:
;;   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n' | cut -c1-21
;; Used by: localchimera-gateway-service (deploy/guix/localchimera-gateway-service.scm)
;; → materialized to /run/secrets/keria-bran, read at process start
;; (never baked into the Guix store, same treatment as LOCALCHIMERA_VAULT_KEY).
;; Leave empty to keep the client tier off.
(setenv "KERIA_BRAN" "")

;; The mail relay account's password (the provider config's `mail` names the
;; relay and the account). Decrypted to /run/secrets/smtp-password, which
;; msmtp reads as it sends. Leave empty for a box that sends no mail.
;; Used by: interface/adapters/email.scm → msmtp --passwordeval
(setenv "SMTP_PASSWORD" "")

;; Provider-specific API tokens (uncomment as needed):
;; (setenv "GUIX_HETZNER_API_TOKEN" "")  ; Hetzner Cloud API (bootstrap only)

;; Monero wallet passphrase — unlocks the wallet file used by
;; monero-wallet-rpc. Pick a strong passphrase; it protects the
;; encrypted .keys file at rest.
;; Used by: monero-service → --password-file (0600, /var/lib/localchimera/monero/wallet-password.txt)
(setenv "MONERO_WALLET_PASSWORD" "")

;; Monero RPC password — authenticates localhost callers (e.g. the
;; ^monero-wallet Goblins actor) against monero-wallet-rpc's HTTP Digest
;; login. Pair this with the rpc-user field of monero-configuration
;; (defaults to "localchimera").
;; Used by: monero-service → --rpc-login localchimera:<password>
(setenv "MONERO_RPC_PASSWORD" "")

;; Monero wallet seed (25-word electrum-style mnemonic) — the root of
;; trust for the localchimera wallet. Everything downstream (addresses,
;; history, balance) is a pure function of this seed + chain state.
;;
;; Cold-start workflow:
;;
;;   1. On any trusted machine (NOT the server, ideally air-gapped):
;;        monero-wallet-cli --generate-new-wallet /tmp/bootstrap \
;;            --mnemonic-language English
;;      Enter a passphrase when prompted. Copy the 25-word seed that it
;;      prints into this variable BELOW, and ALSO write the seed down
;;      on paper and store it offline — if secrets.scm is lost you need
;;      the paper to recover.
;;   2. Set MONERO_WALLET_PASSWORD to the passphrase you chose.
;;   3. `guix deploy` — the monero-service activation sees the seed +
;;      that no wallet file exists yet, writes a one-shot JSON to
;;      /var/lib/localchimera/monero/.wallet-gen.json, runs
;;      `monero-wallet-cli --generate-from-json --offline --command exit`
;;      to materialize the wallet, then deletes the JSON.
;;   4. On subsequent deploys the wallet file already exists, so the
;;      activation is a no-op. The seed in secrets.scm can be left in
;;      place (useful for disaster recovery: wipe the server, deploy
;;      again, same wallet comes back) OR deleted once you trust the
;;      on-disk .keys file + offline backup.
;;
;; Leave empty to skip seed-restore entirely. The operator can still
;; bootstrap the wallet manually via monero-wallet-cli on the server.
(setenv "MONERO_WALLET_SEED" "")

;; SporeStack API token — the long-lived credential for the SporeStack
;; VPS reseller. Token format: 32-64 chars (e.g. "ss_t_..."). Created
;; once via the in-repo Guile script (no pip, no Python, pure Guile):
;;
;;   guile -L module deploy/scripts/sporestack-token-create.scm \
;;         --dollars 10 --currency xmr
;;
;; The script generates a token, prints a Monero payment URI, and
;; polls until SporeStack confirms the payment. Paste the resulting
;; token below.
;;
;; The fleet reconciler reads this at gateway startup and captures it
;; in the reconciler actor's closure — never serialized to the Goblins
;; persistence store. The token is the equivalent of an API key: if it
;; leaks, the attacker can launch/destroy servers on your SporeStack
;; account but cannot access the Monero wallet (that's behind the
;; wallet-policy's separate spend cap).
;; Used by: fleet-reconciler actor → SporeStack API HTTP calls
(setenv "SPORESTACK_TOKEN" "")

;; LUKS full-disk encryption passphrase for fleet-provisioned VMs.
;; Every SporeStack VM gets LUKS-encrypted root so seized drives are
;; unreadable. The bootstrap script writes this passphrase into the
;; LUKS header during initial conversion; the initrd dropbear SSH
;; server prompts for it on each reboot.
;;
;; Keep this passphrase OFFLINE in the same place as the Monero seed.
;; A future Tang server on the existing localchimera host can auto-unlock
;; new VMs (NBDE) so reboots don't need human intervention.
;; Used by: bootstrap-debian.sh → cryptsetup luksFormat
(setenv "LOCALCHIMERA_LUKS_PASSPHRASE" "")

;; KERI ACDC credential schema SAIDs — self-addressing identifiers for
;; the four localchimera credential schemas. The code has placeholder values
;; that work within a single KERIA instance. For production (cross-instance
;; verification), publish the schemas to a KERI schema registry:
;;
;;   1. Draft each schema as JSON (member, supplier, planner, governor)
;;   2. Run `kli schema publish <schema.json>` from the governance AID
;;   3. Record the SAID output and paste it below
;;   4. guix deploy — the credentials module reads these at startup
;;
;; Leave empty to use the built-in placeholder SAIDs.
(setenv "LOCALCHIMERA_SCHEMA_MEMBER"   "")
(setenv "LOCALCHIMERA_SCHEMA_SUPPLIER" "")
(setenv "LOCALCHIMERA_SCHEMA_PLANNER"  "")
(setenv "LOCALCHIMERA_SCHEMA_GOVERNOR" "")

;; Confidential-VPS provider API key — authenticates against the provider's
;; REST API. The provider offers AMD SEV-SNP confidential VMs with
;; BTC/Lightning payment and no KYC. Create an account with the provider,
;; then generate an API key from its console.
;;
;; The fleet reconciler registers this provider when the key is set.
;; Payment is currently manual (BTC invoice displayed in logs). Future:
;; automatic XMR→BTC swap via Haveno/COMIT.
;; Used by: monero-boot → make-vpsbg-provider
(setenv "VPSBG_API_KEY" "")

;; ChangeNow API key — free registration at changenow.io (no KYC for
;; crypto-crypto swaps). The XMR→BTC swapper uses ChangeNow as its
;; primary provider (one-call, refund address support). Without this
;; key, the swapper falls back to Majestic Bank (no refund address).
;; Register at https://changenow.io, go to your dashboard, generate
;; an API key.
;; Used by: monero-boot → ^xmr-btc-swapper
(setenv "CHANGENOW_API_KEY" "")

;; Radicle node identity key passphrase — encrypts the Ed25519 key at
;; rest. Without this, the key sits unencrypted on disk at
;; /var/lib/localchimera/radicle/.radicle/keys/radicle. Radicle 1.6.0+
;; supports passphrase-protected keys via RAD_PASSPHRASE env var.
;; This is the SERVER SEED key's passphrase (materialized to
;; /run/secrets/rad-passphrase on the box); it is NOT the operator's
;; local ops key — do not reuse it for the delegate push.
;; Used by: radicle-service → RAD_PASSPHRASE env
(setenv "RAD_PASSPHRASE" "")

;; ops delegate key passphrase — the LOCAL operator radicle key
;; (~/.radicle/keys/radicle) that signs the canonical `main` during
;; `make ship`. Distinct from RAD_PASSPHRASE above (that's the box seed).
;; `make ship` reads this and feeds it to promote.sh as RAD_OMAR_PASSPHRASE
;; for the `git push rad main`; if empty, promote.sh falls back to the
;; unlocked radicle agent (`rad auth`). Set it so canonical propagation
;; is fully automatic (and headless-safe) — otherwise `make ship` HARD
;; FAILS with a clear message when the agent isn't unlocked, instead of
;; silently leaving the Explorer's canonical behind the live site.
;; Used by: Makefile `ship` → promote.sh (local delegate push only; never
;; sent to the box).
(setenv "RAD_OMAR_PASSPHRASE" "")
