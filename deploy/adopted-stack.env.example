# deploy/adopted-stack.env — the endpoints the delegates read.
#
# Every LOCALCHIMERA_*_URL names the upstream for its delegate seam
# (module/localchimera/delegates.scm) and its parity suite's live leg
# (tests/parity/*.scm). Unset = fail-closed: the seam answers
# 'unavailable and the suite skips the live leg loudly.
#
# Verified 2026-10-21 against live containers: five answered their
# parity legs green end-to-end (delegate → HTTP → real service).
# Honest gaps below: odoo's execute_kw needs a session-auth step the
# delegate doesn't do yet; litellm needs a model backend; decidim needs
# postgres; cc-node's registry path is unverified; AP needs a server.
#
#   service           container                       verified live
#   ───────────────   ─────────────────────────────   ──────────────
LOCALCHIMERA_NTFY_URL=http://ntfy:2586            # binwiederhier/ntfy        ✓
LOCALCHIMERA_OPA_URL=http://opa:8181              # openpolicyagent/opa       ✓
LOCALCHIMERA_RADICALE_URL=http://radicale:5232    # tomsquest/docker-radicale ✓ (auth=none for dev)
LOCALCHIMERA_JENA_URL=http://fuseki:3030          # stain/jena-fuseki         ✓ (dataset: /ds)
#
#   the rest — images declared in deploy/guix/adopted-services.scm, live
#   legs pending a reachable endpoint:
LOCALCHIMERA_ODOO_URL=http://odoo:8069            # odoo:16 + OCA ddmrp
LOCALCHIMERA_CCNODE_URL=http://cc-node:2020       # credit-commons cc-node
LOCALCHIMERA_DECIDIM_URL=http://decidim:3000      # decidim/decidim + postgres
LOCALCHIMERA_CPSAT_URL=http://cpsat:5000          # deploy/sidecars/cpsat-solve.py      ✓
LOCALCHIMERA_LITELLM_URL=http://litellm:4000      # berriai/litellm + a model backend
LOCALCHIMERA_AP_URL=http://ap:8000                # any ActivityPub-speaking server

# ── secrets for adopted-stack.docker-compose.yml ────────────────────────
# all required — compose refuses to start without them (?set-in-env)
POSTGRES_USER=localchimera
POSTGRES_PASSWORD=
DECIDIM_SECRET_KEY_BASE=
FUSEKI_ADMIN_PASSWORD=
LITELLM_MASTER_KEY=
CC_NODE_DB=
LITELLM_LOCAL_BASE=http://ollama:11434/v1   # local model backend
OPENAI_API_KEY=                            # optional remote lane

# Odoo's delegate authenticates — these feed execute_kw's (db uid pass)
LOCALCHIMERA_ODOO_DB=odoo
LOCALCHIMERA_ODOO_USER=
LOCALCHIMERA_ODOO_PASSWORD=
